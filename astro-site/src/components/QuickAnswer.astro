---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<p class="quick-answer" set:html={text} />

<style>
  .quick-answer {
    margin: 20px 0 0;
    padding-left: 20px;
    border-left: 1px solid var(--hairline);
    max-width: 660px;
    color: var(--fg);
    font-size: 17px;
    letter-spacing: 0.022em;
    word-spacing: 0.04em;
    line-height: 1.8;
    text-align: left;
  }

  .quick-answer :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .quick-answer {
      font-size: 16px;
      padding-left: 16px;
    }
  }
</style>
