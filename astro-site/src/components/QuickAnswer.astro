---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<aside class="quick-answer" aria-label="In short">
  <p class="quick-answer-label">In short</p>
  <p set:html={text} />
</aside>

<style>
  .quick-answer {
    max-width: 440px;
    margin: 0 var(--page-pad) 48px auto;
    color: var(--faint);
    font-size: 12px;
    line-height: 1.6;
    letter-spacing: 0.02em;
  }

  .quick-answer p {
    margin: 0;
  }

  .quick-answer .quick-answer-label {
    margin-bottom: 6px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .quick-answer :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 640px) {
    .quick-answer {
      margin: 0 var(--page-pad) 40px;
    }
  }
</style>
