---
/**
 * Ranked-list layout for /alternatives/.
 *
 * Why this exists next to AlternativeLayout: that layout renders exactly one
 * shape, Sonura in column A against one competitor in column B, which is a
 * single-product pitch. For queries where the SERP is majority listicles, that
 * shape cannot satisfy the intent no matter how good the copy is, because the
 * reader asked to see several options.
 *
 * Use this layout only where the top 10 for the target query is majority
 * listicles. Where it is majority single-product pages, AlternativeLayout is
 * already the right shape and the page should be left alone.
 *
 * Unlike AlternativeLayout, this emits ItemList JSON-LD for the ranking.
 */
import BaseLayout from './BaseLayout.astro';
import { resolveAlternatives, type AlternativeEntry, LAST_VERIFIED } from '../data/alternatives';

interface FAQ {
  question: string;
  answer: string;
}

interface Source {
  label: string;
  url: string;
}

interface Props {
  competitor: string;
  competitorSlug: string;
  title: string;
  description: string;
  keywords: string;
  headline: string;
  /** the direct answer block: 2 to 3 sentences, above the fold, lifted verbatim by answer engines */
  quickAnswer: string;
  entries: AlternativeEntry[];
  criteria: string[];
  /** the non-negotiable block: when the competitor is still the right call */
  stillRightTitle: string;
  stillRightBody: string;
  faqs: FAQ[];
  sources?: Source[];
  finalCtaTitle?: string;
  finalCtaSubtitle?: string;
  finalCtaButtonText?: string;
  appUrl?: string;
}

const {
  competitor,
  competitorSlug,
  title,
  description,
  keywords,
  headline,
  quickAnswer,
  entries,
  criteria,
  stillRightTitle,
  stillRightBody,
  faqs,
  sources = [],
  finalCtaTitle,
  finalCtaSubtitle,
  finalCtaButtonText = 'Start free',
  appUrl = 'https://app.sonurastudio.com/',
} = Astro.props;

const ranked = resolveAlternatives(entries);
const canonical = `https://sonurastudio.com/alternatives/${competitorSlug}/`;
const stripHtml = (value: string) => value.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description: description,
    url: canonical,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://sonurastudio.com/' },
      { '@type': 'ListItem', position: 2, name: `${competitor} Alternatives`, item: canonical },
    ],
  },
  /* The ranking itself. AlternativeLayout has never emitted this. */
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: headline,
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: ranked.length,
    itemListElement: ranked.map((item) => ({
      '@type': 'ListItem',
      position: item.rank,
      name: item.name,
      description: stripHtml(item.verdict),
      url: item.isSonura ? 'https://sonurastudio.com/' : item.href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: stripHtml(faq.answer) },
    })),
  },
];

const cols = [
  { key: 'stems', label: 'Stems' },
  { key: 'filesOut', label: 'Files out' },
  { key: 'commercial', label: 'Commercial use' },
  { key: 'training', label: 'Training data' },
] as const;
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
  jsonLd={jsonLd}
>
  <div class="alx">
    <!-- 1 / headline + 2 / direct answer -->
    <header class="alx-hero">
      <p class="section-kicker">Alternatives / Verified {LAST_VERIFIED}</p>
      <h1 class="alx-h1">{headline}</h1>
      <div class="alx-answer" set:html={quickAnswer} />
      <div class="alx-cta-row">
        <a href={appUrl} class="alx-cta">{finalCtaButtonText}</a>
        <span class="alx-pill">free to start</span>
        <span class="alx-pill">no credit card</span>
      </div>
    </header>

    <!-- 5 / how we picked, stated before the ranking is justified -->
    <section class="alx-section">
      <p class="section-kicker">01 / How we picked</p>
      <ul class="alx-criteria">
        {criteria.map((c) => <li>{c}</li>)}
      </ul>
      <p class="alx-note">
        Every spec below is pulled from the same dated sheet that drives our
        <a href="/compare/" class="text-link">model comparisons</a>, so it cannot drift between pages.
        pricing is given as a shape rather than a figure: competitor pricing moves, and a stale number
        helps nobody. the links go to their own sites so you can check us.
      </p>
    </section>

    <!-- 3 / the ranked list -->
    <section class="alx-section">
      <p class="section-kicker">02 / The ranking</p>
      <ol class="alx-list">
        {ranked.map((item) => (
          <li class:list={['alx-item', { 'is-sonura': item.isSonura }]}>
            <div class="alx-item-head">
              <span class="alx-rank">{String(item.rank).padStart(2, '0')}</span>
              <div>
                <h2 class="alx-name">
                  {item.name}
                  {item.isSonura && <span class="alx-badge">our pick</span>}
                </h2>
                <p class="alx-verdict">{item.verdict}</p>
              </div>
            </div>

            <dl class="alx-judgement">
              <div>
                <dt>Best for</dt>
                <dd>{item.bestFor}</dd>
              </div>
              <div>
                <dt>Skip it if</dt>
                <dd>{item.skipIf}</dd>
              </div>
            </dl>

            <dl class="alx-specs">
              <div><dt>Stems</dt><dd>{item.stems}</dd></div>
              <div><dt>Files out</dt><dd>{item.filesOut}</dd></div>
              <div><dt>Commercial use</dt><dd>{item.commercial}</dd></div>
              <div><dt>Pricing</dt><dd>{item.pricing}</dd></div>
            </dl>

            <p class="alx-out">
              {item.isSonura ? (
                <a href="/" class="text-link">see what Sonura makes</a>
              ) : (
                <a href={item.href} class="text-link" target="_blank" rel="noopener">
                  {item.name} official site
                </a>
              )}
            </p>
          </li>
        ))}
      </ol>
    </section>

    <!-- 4 / at a glance, same columns for every row -->
    <section class="alx-section">
      <p class="section-kicker">03 / At a glance</p>
      <div class="alx-table-wrap">
        <table class="alx-table">
          <thead>
            <tr>
              <th scope="col">&nbsp;</th>
              {cols.map((c) => <th scope="col">{c.label}</th>)}
            </tr>
          </thead>
          <tbody>
            {ranked.map((item) => (
              <tr class:list={[{ 'is-sonura': item.isSonura }]}>
                <th scope="row">{item.short}</th>
                {cols.map((c) => <td>{item[c.key]}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 6 / when the competitor is still the right call -->
    <section class="alx-section alx-still">
      <p class="section-kicker">04 / The other side</p>
      <h2 class="alx-h2">{stillRightTitle}</h2>
      <div class="alx-prose" set:html={stillRightBody} />
    </section>

    <!-- 7 / FAQ -->
    <section class="alx-section">
      <p class="section-kicker">05 / Questions</p>
      <div class="alx-faqs">
        {faqs.map((faq) => (
          <details class="alx-faq">
            <summary>{faq.question}</summary>
            <div class="alx-faq-body" set:html={faq.answer} />
          </details>
        ))}
      </div>
    </section>

    {sources.length > 0 && (
      <section class="alx-section alx-sources">
        <p class="section-kicker">Sources / Verified {LAST_VERIFIED}</p>
        <ul class="alx-sources-list">
          {sources.map((src) => (
            <li><a href={src.url} target="_blank" rel="noopener">{src.label}</a></li>
          ))}
        </ul>
      </section>
    )}

    <!-- 9 / final CTA -->
    <section class="alx-final">
      <h2 class="alx-h2">{finalCtaTitle ?? `The ${competitor} alternative for producers`}</h2>
      {finalCtaSubtitle && <p class="alx-final-sub">{finalCtaSubtitle}</p>}
      <a href={appUrl} class="button primary large">{finalCtaButtonText}</a>
    </section>
  </div>

  <style>
    .alx {
      width: 100%;
      padding: clamp(56px, 9vh, 110px) var(--page-pad) clamp(96px, 12vw, 140px);
      color: var(--fg);
    }

    .alx-hero { max-width: 900px; }
    .alx-h1 {
      margin: 0 0 28px;
      font-family: var(--font-display);
      font-weight: 400;
      font-size: clamp(40px, 6.2vw, 92px);
      line-height: 0.98;
      letter-spacing: 0.01em;
      text-transform: uppercase;
    }
    .alx-answer {
      font-size: clamp(17px, 1.7vw, 21px);
      line-height: 1.7;
      color: var(--fg);
      letter-spacing: 0.012em;
    }
    .alx-answer :global(p) { margin: 0 0 18px; }
    .alx-answer :global(p:last-child) { margin-bottom: 0; }
    .alx-answer :global(strong) { font-weight: 700; }

    .alx-cta-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px;
      margin-top: 36px;
    }
    .alx-cta {
      display: inline-block;
      padding: 15px 28px;
      border: 1px solid var(--fg);
      color: var(--fg);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      font-size: 12px;
    }
    .alx-cta:hover { background: var(--fg); color: var(--bg); }
    .alx-pill {
      font-size: 12px;
      text-transform: lowercase;
      color: var(--muted);
      letter-spacing: 0.04em;
    }

    .alx-section {
      margin-top: clamp(64px, 8vw, 104px);
      padding-top: clamp(40px, 5vw, 56px);
      border-top: 1px solid var(--hairline);
    }

    .alx-h2 {
      margin: 0 0 24px;
      font-family: var(--font-display);
      font-weight: 400;
      font-size: clamp(30px, 3.6vw, 52px);
      line-height: 1.02;
      letter-spacing: 0.01em;
      text-transform: uppercase;
    }

    .alx-criteria {
      margin: 0 0 24px;
      padding: 0;
      list-style: none;
      max-width: 760px;
    }
    .alx-criteria li {
      position: relative;
      padding-left: 28px;
      margin-bottom: 12px;
      color: var(--fg);
      font-size: 16px;
      line-height: 1.7;
    }
    .alx-criteria li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 12px;
      width: 14px;
      height: 1px;
      background: var(--fg);
    }
    .alx-note,
    .alx-prose :global(p) {
      max-width: 760px;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.85;
      letter-spacing: 0.02em;
      margin: 0 0 18px;
    }
    .alx-prose :global(p:last-child) { margin-bottom: 0; }

    /* --- the ranked entries --- */
    .alx-list { margin: 0; padding: 0; list-style: none; }
    .alx-item {
      padding: 32px 0;
      border-top: 1px solid var(--border);
    }
    .alx-item:first-child { border-top: none; padding-top: 0; }
    .alx-item.is-sonura { border-left: 2px solid var(--fg); padding-left: 24px; }

    .alx-item-head { display: flex; gap: 20px; align-items: flex-start; }
    .alx-rank {
      font-family: var(--font-display);
      font-size: clamp(28px, 3vw, 40px);
      line-height: 1;
      color: var(--faint);
      flex: none;
    }
    .alx-name {
      margin: 0 0 8px;
      font-size: clamp(20px, 2.2vw, 28px);
      font-weight: 700;
      letter-spacing: 0.01em;
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .alx-badge {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      border: 1px solid var(--fg);
      padding: 4px 8px;
      font-weight: 400;
    }
    .alx-verdict {
      margin: 0;
      color: var(--muted);
      font-size: 16px;
      line-height: 1.7;
    }

    .alx-judgement {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin: 24px 0 0;
      padding-left: calc(clamp(28px, 3vw, 40px) + 20px);
    }
    .alx-item.is-sonura .alx-judgement { padding-left: calc(clamp(28px, 3vw, 40px) + 20px); }
    .alx-judgement dt,
    .alx-specs dt {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: var(--faint);
      margin-bottom: 6px;
    }
    .alx-judgement dd,
    .alx-specs dd {
      margin: 0;
      font-size: 15px;
      line-height: 1.75;
      color: var(--fg);
    }
    .alx-judgement div { margin: 0; }

    .alx-specs {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 24px;
      margin: 24px 0 0;
      padding-left: calc(clamp(28px, 3vw, 40px) + 20px);
    }
    .alx-specs dd { color: var(--muted); font-size: 14px; }

    .alx-out {
      margin: 20px 0 0;
      padding-left: calc(clamp(28px, 3vw, 40px) + 20px);
      font-size: 14px;
    }

    /* --- at a glance --- */
    .alx-table-wrap { overflow-x: auto; }
    .alx-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
      min-width: 720px;
    }
    .alx-table th,
    .alx-table td {
      text-align: left;
      vertical-align: top;
      padding: 16px 18px;
      border: 1px solid var(--border);
      line-height: 1.6;
    }
    .alx-table thead th {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: var(--faint);
      font-weight: 400;
    }
    .alx-table tbody th {
      font-weight: 700;
      white-space: nowrap;
      color: var(--fg);
    }
    .alx-table td { color: var(--muted); }
    .alx-table tr.is-sonura th,
    .alx-table tr.is-sonura td { color: var(--fg); }

    /* --- faq --- */
    .alx-faqs { border-top: 1px solid var(--border); max-width: 900px; }
    .alx-faq { border-bottom: 1px solid var(--border); }
    .alx-faq summary {
      cursor: pointer;
      padding: 20px 0;
      font-size: 16px;
      font-weight: 700;
      list-style: none;
      display: flex;
      justify-content: space-between;
      gap: 20px;
    }
    .alx-faq summary::-webkit-details-marker { display: none; }
    .alx-faq summary::after { content: '+'; color: var(--faint); }
    .alx-faq[open] summary::after { content: '\2212'; }
    .alx-faq-body {
      padding: 0 0 22px;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.85;
      max-width: 760px;
    }
    .alx-faq-body :global(p) { margin: 0 0 14px; }
    .alx-faq-body :global(p:last-child) { margin-bottom: 0; }

    /* --- sources --- */
    .alx-sources-list { margin: 0; padding: 0; list-style: none; max-width: 860px; }
    .alx-sources-list li { margin-bottom: 10px; }
    .alx-sources-list a {
      color: var(--muted);
      font-size: 13px;
      line-height: 1.7;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .alx-sources-list a:hover { color: var(--fg); }

    /* --- final cta --- */
    .alx-final {
      margin-top: clamp(64px, 8vw, 104px);
      padding-top: clamp(40px, 5vw, 56px);
      border-top: 1px solid var(--hairline);
      text-align: center;
    }
    .alx-final-sub {
      max-width: 620px;
      margin: 0 auto 28px;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.8;
    }

    @media (max-width: 720px) {
      .alx-judgement,
      .alx-specs,
      .alx-out { padding-left: 0; }
      .alx-judgement { grid-template-columns: 1fr; gap: 18px; }
      .alx-specs { grid-template-columns: 1fr; }
      .alx-item.is-sonura { padding-left: 16px; }
    }
  </style>
</BaseLayout>
