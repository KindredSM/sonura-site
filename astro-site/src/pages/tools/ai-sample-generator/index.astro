---
import ToolLayout from '../../../layouts/ToolLayout.astro';

const features = [
  { title: 'Unique every time', description: 'Every creation is original. No more shared sounds with thousands of producers using the same pack.' },
  { title: 'One-shots and phrases', description: 'Drum hits, melodic stabs, vocal chops, bass plucks, textural hits. Any type of sample.' },
  { title: 'Describe what you need', description: 'Instead of browsing folders, write the sound: instrument, tone, length, and character.' },
  { title: 'Chop and flip', description: 'Created samples are designed to be processed. Resample, pitch, reverse, granularize.' },
  { title: 'Build custom kits', description: 'Create a dozen samples, keep the best, and assemble a unique kit for your session.' },
  { title: 'No clearing needed', description: 'Created material does not carry sample clearance issues. Check plan terms for commercial use.' },
];

const howItWorksSteps = [
  'Describe the sample: instrument, tone, length, and processing style.',
  'Create one-shots or short phrases you can chop, flip, and resample.',
  'Load into your sampler or keep creating until you find the right sound.',
];

const useCases = [
  { title: 'Beat makers', description: 'Original material for kits and chops without digging through packs everyone else uses.' },
  { title: 'Sound designers', description: 'Unusual textures, hits, and experimental material for electronic music and post-production.' },
  { title: 'Hip-hop and trap', description: 'Melodic and drum samples that feel fresh. Layer and process for your signature sound.' },
  { title: 'Experimental artists', description: 'Happy accidents for resampling, granular processing, and creative sound manipulation.' },
];

const faqs = [
  { question: 'What can I create?', answer: 'One-shots, drum hits, melodic stabs, vocal chops, textural hits. Describe the sound and get audio back.' },
  { question: 'Are created samples unique?', answer: 'Yes. Each creation is new. Process and combine them like any other source material.' },
  { question: 'Can I sell beats using these?', answer: 'Yes. Samples are royalty-free with no attribution needed. On the free plan they are public domain (CC0). On any paid plan they are exclusively yours, so you can sell beats and sample packs built from them.' },
  { question: 'How is this different from loops?', answer: 'Samples are typically one-shots or short hits. Loops are longer phrases designed to repeat. See the loop maker.' },
];

const relatedTools = [
  { title: 'Loop Maker', href: '/tools/ai-loop-maker/', description: 'Longer looping phrases instead of one-shots.' },
  { title: 'Beat Maker', href: '/tools/ai-beat-maker/', description: 'Full beats when you want structure, not just samples.' },
  { title: 'Sound Effects', href: '/tools/ai-sound-effects/', description: 'Short SFX for non-musical hits and transitions.' },
  { title: 'Stem Separator', href: '/tools/stem-separator/', description: 'Pull vocals, drums, or instrumentals out of any track instead of generating from scratch.' },
];

const relatedBlogPosts = [
  { title: 'The 5 best AI sample generators (compared)', href: '/blog/best-ai-sample-generators-2026/' },
  { title: 'Why created samples beat sample packs', href: '/blog/ai-sample-generator-unique-samples/' },
];
---

<ToolLayout
  toolName="Sample Generator"
  toolSlug="ai-sample-generator"
  title="Free AI Sample Generator | One-Shots and Kits - Sonura"
  description="Create unique one-shots in seconds: punchy 808s, dusty piano stabs, vocal chops. Free AI sample generator in your browser or as a DAW plugin."
  keywords="ai sample generator, free ai sample generator, sample generator, ai sample maker, sample maker, one shot generator, custom sample kits"
  headline="Free AI Sample Generator"
  subhead="One-shots, drum hits, melodic stabs, textures. Describe what you need and build custom kits. No packs, no sharing sounds."
  quickAnswer="Sonura is an AI sample generator. Describe a sound, such as a punchy 808 kick or a dusty piano stab, and it creates a unique one-shot you can use in any sampler or DAW. It also runs inside your DAW as the free <a href='/plugin/ai-sample-generator/'>Sonura Flow sample generator plugin</a>. Free-plan sounds are public domain (CC0), and paid plans make them exclusively yours."
  features={features}
  howItWorksTitle="How it works"
  howItWorksSteps={howItWorksSteps}
  useCases={useCases}
  faqs={faqs}
  appUrl="https://app.sonurastudio.com/"
  ctaPrimaryText="Create samples free"
  finalCtaTitle="Start creating samples"
  finalCtaButtonText="Try it free"
  relatedTools={relatedTools}
  relatedBlogPosts={relatedBlogPosts}
/>
