---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const appUrl = 'https://app.sonurastudio.com/studio';
const img = (name: string) => `/images/guides/dj-remix/${name}.webp`;
const description = 'Whole track in, vocal out, new beat under it. A DJ remix in Sonura, step by step.';
---

<BaseLayout
  title="Remix any track in Sonura | Step by step guide"
  description={description}
  canonical="https://sonurastudio.com/guides/dj-remix/"
  ogTitle="Remix any track in Sonura"
  ogImage="https://sonurastudio.com/images/guides/dj-remix/og.png"
  ogImageAlt="A vocal stem on its own lane in the Sonura studio, with the Composer open"
  noindex={true}
>
  <article class="guide">
    <header class="guide-head">
      <div class="guide-head-text">
        <p class="section-kicker">Guide / DJ remixes / 2 min</p>
        <h1 class="headline">Remix any track in Sonura</h1>
        <p class="guide-lede">Making a remix without a DAW, a pile of plugins and ten years of producing is a pain in the ass. Here's a better way.</p>
      </div>
      <video controls playsinline preload="metadata" poster="/videos/dj-remix-reel-poster.jpg" width="720" height="1280" aria-label="A tech house edit made in Sonura: stems split, then drums, bass and piano added with the Composer">
        <source src="/videos/dj-remix-reel.webm" type="video/webm" />
        <source src="/videos/dj-remix-reel.mp4" type="video/mp4" />
      </video>
    </header>

    <section class="step" id="import">
      <div class="step-text">
        <p class="step-num">01</p>
        <h2 class="section-title">Drop in the whole track</h2>
        <p>Drag in the full song, not just the acapella.</p>
        <p>Sonura asks for the BPM and key. Fill them in and the project locks to them.</p>
      </div>
      <figure><img src={img('tempo-prompt')} alt="The tempo prompt asking for the BPM and key of a dropped track" width="1200" height="600" fetchpriority="high" /></figure>
    </section>

    <section class="step" id="trim">
      <div class="step-text">
        <p class="step-num">02</p>
        <h2 class="section-title">Trim the start</h2>
        <p>Most downloads start with a bit of dead air, so the kick misses bar 1.</p>
        <p>Right click &rarr; <strong>Timing</strong> &rarr; <strong>Trim the start</strong>. Now it starts on the first hit.</p>
      </div>
      <figure>
        <img src={img('trim-before')} alt="Before: silence pushes the first beat past bar 1" width="1520" height="350" loading="lazy" />
        <img src={img('trim-after')} alt="After: the first hit sits on bar 1" width="1520" height="350" loading="lazy" />
        <figcaption>Before and after.</figcaption>
      </figure>
    </section>

    <section class="step" id="warp">
      <div class="step-text">
        <p class="step-num">03</p>
        <h2 class="section-title">Warp it to the grid</h2>
        <p>Loads of tunes aren't a round BPM. Something at 120.27 sounds fine for a few bars, then slowly drifts.</p>
        <p>Right click &rarr; <strong>Timing</strong> &rarr; <strong>Match clip to project tempo</strong>. Sonura finds the real tempo and locks it to yours.</p>
        <p>Metronome on, have a listen. Still a hair off? <strong>Shift a 16th</strong>.</p>
        <p class="aside">Want the original tempo instead? <strong>Match project to clip tempo</strong>.</p>
      </div>
      <figure><img src={img('timing-menu')} alt="The clip menu's Timing options: match tempo, trim the start, trim silence and shift a 16th" width="1520" height="1040" loading="lazy" /></figure>
    </section>

    <section class="step" id="stems">
      <div class="step-text">
        <p class="step-num">04</p>
        <h2 class="section-title">Split the stems</h2>
        <p>Right click &rarr; <strong>Split stems</strong> &rarr; <strong>Two stems</strong>.</p>
        <p class="aside">Want the drums or bass too? Pick six stems.</p>
      </div>
      <figure><img src={img('split-stems')} alt="The split stems panel set to two stems" width="1380" height="740" loading="lazy" /></figure>
    </section>

    <section class="step" id="vocal">
      <div class="step-text">
        <p class="step-num">05</p>
        <h2 class="section-title">Keep the vocal</h2>
        <p>Vocals and instrumental land on their own lanes, in time. The original gets muted.</p>
        <p>Mute the instrumental too. Now it's just the vocal.</p>
      </div>
      <figure><img src={img('stems-landed')} alt="Vocals and Instrumental lanes under the muted original" width="1520" height="795" loading="lazy" /></figure>
    </section>

    <section class="step" id="build">
      <div class="step-text">
        <p class="step-num">06</p>
        <h2 class="section-title">Build around it</h2>
        <p>Open the Composer and ask for what you want: <em>build a house track around the vocal</em>.</p>
        <p>It builds the parts in your key and tempo and leaves the vocal alone. Don't like a part? Swap it.</p>
      </div>
      <figure><img src={img('build-around-vocal')} alt="The vocal on its own lane with the Composer open" width="1520" height="1049" loading="lazy" /></figure>
    </section>

    <section class="step" id="export">
      <div class="step-text">
        <p class="step-num">07</p>
        <h2 class="section-title">Take it to the gig</h2>
        <p><strong>Download</strong> &rarr; <strong>WAV</strong>. Or grab the stems and finish it in your DJ software.</p>
      </div>
      <figure><img src={img('download')} alt="The download menu with track and stems in WAV or MP3" width="1120" height="400" loading="lazy" /></figure>
    </section>

  </article>

  <section class="final-cta" aria-labelledby="final-cta-title">
    <div class="final-cta-inner">
      <h2 id="final-cta-title" class="final-cta-title">Bring a track.<br />Leave with a remix.</h2>
      <p class="final-cta-subtitle">Your next set starts here</p>
      <div class="final-cta-form">
        <a class="button primary large" href={appUrl}>Start your remix</a>
      </div>
      <div class="final-cta-trust">
        <div class="trust-item">Free to start</div>
        <div class="trust-item">No credit card</div>
        <div class="trust-item">WAV and stems</div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .guide {
    margin: clamp(48px, 7vw, 80px) 0 clamp(56px, 7vw, 96px);
    padding: 0 var(--page-pad);
    color: var(--fg);
  }
  .guide-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  .guide-head video {
    display: block;
    width: clamp(260px, 24vw, 360px);
    height: auto;
    aspect-ratio: 9 / 16;
    background: var(--panel-bg);
    border: 1px solid var(--border-light);
  }
  .guide .headline { margin: 0 0 24px; }
  .guide .section-title { margin: 0 0 28px; }
  .step-text p,
  .guide-lede {
    font-size: clamp(17px, 1.6vw, 22px);
    line-height: 1.6;
    letter-spacing: 0.022em;
    color: var(--muted);
    margin: 0 0 16px;
  }
  .guide .guide-lede { font-size: clamp(20px, 2vw, 26px); max-width: 980px; text-wrap: pretty; }
  .guide .step-num {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }
  .guide .aside { font-size: clamp(15px, 1.25vw, 17px); }
  .guide strong,
  .guide em { color: var(--fg); }
  .guide strong { font-weight: 600; }
  .step {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    margin-top: clamp(72px, 10vw, 128px);
  }
  .step figure { margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .step img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border-light);
  }
  .step figcaption { font-size: 14px; color: var(--faint); }
  .final-cta { border-top: none; }
  @media (max-width: 960px) {
    .step { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .guide-head { grid-template-columns: minmax(0, 1fr); }
    .guide-head video { width: min(100%, 420px); }
  }
</style>
