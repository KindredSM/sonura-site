---
import BaseLayout from '../../layouts/BaseLayout.astro';

const guides = [
  {
    href: '/guides/dj-remix/',
    title: 'Remix any track in Sonura',
    blurb: 'Whole track in, vocal out, new beat under it.',
    meta: 'DJ remixes / 2 min',
    image: '/images/guides/dj-remix/og.png',
  },
];
---

<BaseLayout
  title="Guides | Sonura"
  description="Step by step guides for the Sonura studio."
  canonical="https://sonurastudio.com/guides/"
  noindex={true}
>
  <section class="guides">
    <p class="section-kicker">Sonura studio</p>
    <h1 class="headline">Guides</h1>
    <ul>
      {guides.map((g) => (
        <li>
          <a class="guide-row" href={g.href}>
            <span class="guide-row-text">
              <span class="section-kicker">{g.meta}</span>
              <span class="section-title">{g.title}</span>
              <span class="blurb">{g.blurb}</span>
              <span class="read">Read the guide &rarr;</span>
            </span>
            <img src={g.image} alt="" width="1200" height="630" />
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .guides {
    margin: clamp(48px, 7vw, 80px) 0 clamp(72px, 9vw, 120px);
    padding: 0 var(--page-pad);
  }
  .guides .headline { margin: 0 0 clamp(32px, 5vw, 56px); }
  ul { list-style: none; margin: 0; padding: 0; }
  li { border-top: 1px solid var(--hairline); }
  .guide-row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    padding: clamp(32px, 4vw, 48px) 0;
    color: var(--fg);
    text-decoration: none;
  }
  .guide-row-text { display: flex; flex-direction: column; gap: 16px; }
  .guide-row .section-kicker { margin: 0; }
  .blurb { font-size: clamp(17px, 1.6vw, 22px); line-height: 1.6; letter-spacing: 0.022em; color: var(--muted); }
  .read { font-size: 13px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg); }
  .guide-row img { display: block; width: 100%; height: auto; border: 1px solid var(--border-light); }
  .guide-row:hover img { border-color: var(--hairline); }
  .guide-row:hover .read { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 7px; }
  @media (max-width: 960px) {
    .guide-row { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .guide-row img { order: -1; }
  }
</style>
