---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/home-editorial.css';
import '../../styles/home-v2.css';
import { Image } from 'astro:assets';
import newThumbnail from '../../assets/images/new-thumbnail.jpg';

// One list feeds both the visible FAQ and the FAQPage schema, so the two
// can't drift apart. Answers are plain text: the schema gets them verbatim.
const faqs = [
  {
    q: 'What is Sonura?',
    a: 'An ethical AI music studio. It makes royalty-free loops, vocals, one-shots, sound effects, stems, and full tracks from a text prompt, in your browser or inside your DAW.',
  },
  {
    q: 'Who founded Sonura?',
    a: 'Kindred Salway and Blue Bookhard, in London.',
  },
  {
    q: 'Is Sonura free?',
    a: 'Yes. You get 20 credits when you sign up and more each day, with no card needed. Starter, Pro, and Max add more credits.',
  },
  {
    q: 'Do I own what I make?',
    a: 'On paid plans, yes. Your work stays private and yours to sell and release, with no royalty splits. Free plan work is public by default and released under CC0.',
  },
  {
    q: 'What makes Sonura ethical?',
    a: 'It is built on licensed music, not scraped catalogs, and it gives you editable parts rather than a finished song, so the creative decisions stay with you.',
  },
  {
    q: 'Does Sonura work in my DAW?',
    a: 'Yes. Sonura Flow is a free VST3 and AU plugin for Ableton Live, Logic Pro, FL Studio, Studio One, Bitwig, Cubase, Reaper, and GarageBand, on Mac and Windows.',
  },
  {
    q: 'How is Sonura different from Suno?',
    a: 'Suno makes finished songs. Sonura makes parts you can edit, with stems on every plan and a plugin that puts them straight into your DAW.',
  },
  {
    q: 'Can I cancel anytime?',
    a: 'Yes. Plans are month to month. Cancel in settings and you keep access until the billing period ends.',
  },
];

// Key facts, rendered as a real <table> so crawlers and AI answer engines
// can read each row as a labelled fact. Values may carry inline links.
const keyFacts = [
  { label: 'Company', value: 'Sonura (Sonura Studio)' },
  { label: 'Founders', value: 'Kindred Salway and Blue Bookhard' },
  { label: 'Based in', value: 'London, UK' },
  { label: 'What it makes', value: 'Loops, vocals, one-shots, sound effects, stems, and full tracks' },
  { label: 'Products', value: 'Web studio, <a href="/plugin/">Sonura Flow plugin</a>, Sonura Split, <a href="/tools/">free tools</a>' },
  { label: 'Works with', value: 'Ableton Live, Logic Pro, FL Studio, Studio One, Bitwig, Cubase, Reaper, GarageBand' },
  { label: 'Pricing', value: 'Free plan, plus Starter, Pro, and Max. <a href="/pricing/">See pricing</a>' },
  { label: 'Rights', value: 'Paid plans: private and yours, no royalty splits. Free plan and public work: CC0' },
  { label: 'Training data', value: 'Licensed, not scraped. <a href="/how-we-work-with-artists/">How we work with artists</a>' },
  { label: 'Users', value: '17,000+' },
  { label: 'Support', value: 'Email <a href="mailto:kindred@sonurastudio.com">kindred@sonurastudio.com</a> or ask in <a href="https://discord.com/invite/Yk8RD3Nmyh" target="_blank" rel="noopener">Discord</a>' },
  { label: 'Affiliations', value: 'Member, Music Technology UK. Supporter, AI For Music principles' },
  { label: 'Alternatives to', value: '<a href="/alternatives/suno-alternative/">Suno</a>, <a href="/alternatives/udio-alternative/">Udio</a>, <a href="/alternatives/splice-alternative/">Splice</a>, <a href="/alternatives/soundraw-alternative/">Soundraw</a>, <a href="/alternatives/aiva-alternative/">AIVA</a>' },
];

const orgId = 'https://sonurastudio.com/#organization';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": orgId,
    "name": "Sonura",
    "alternateName": "Sonura Studio",
    "url": "https://sonurastudio.com/",
    "logo": "https://sonurastudio.com/demo-image.jpeg",
    "description": "Sonura is an ethical AI music studio. It makes royalty-free loops, vocals, one-shots, sound effects, stems, and full tracks from licensed music, in the browser or inside your DAW.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "London",
      "addressCountry": "GB"
    },
    "founder": [
      {
        "@type": "Person",
        "name": "Kindred Salway",
        "jobTitle": "Co-founder",
        "sameAs": [
          "https://www.linkedin.com/in/kindred-salway-8a05b6240/",
          "https://x.com/kindredsalway"
        ]
      },
      {
        "@type": "Person",
        "name": "Blue Bookhard",
        "jobTitle": "Co-founder",
        "sameAs": [
          "https://www.linkedin.com/in/bluebookhard/",
          "https://www.instagram.com/iambluetyler/"
        ]
      }
    ],
    "memberOf": [
      { "@type": "Organization", "name": "Music Technology UK", "url": "https://musictechnology.uk/" }
    ],
    "sameAs": [
      "https://twitter.com/sonurastudio",
      "https://www.instagram.com/sonurastudio/",
      "https://discord.com/invite/Yk8RD3Nmyh"
    ],
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "kindred@sonurastudio.com",
      "contactType": "Customer Support",
      "availableLanguage": "English"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "About Sonura",
    "url": "https://sonurastudio.com/about/",
    "description": "What Sonura is, who makes it, and the key facts about the company.",
    "mainEntity": { "@id": orgId }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }
];
---

<BaseLayout
  title="About Sonura | The Ethical AI Music Studio"
  description="Sonura is an ethical AI music studio: royalty-free loops, vocals, stems, and full tracks from licensed music, in your DAW."
  keywords="about sonura, sonura studio, ethical ai music studio, ai music company, kindred salway, blue bookhard, sonura founders"
  canonical="https://sonurastudio.com/about/"
  ogTitle="About Sonura - The Ethical AI Music Studio"
  ogDescription="Who makes Sonura, and why."
  jsonLd={jsonLd}
  bodyClass="editorial-home home-v2"
>
  <section class="about-hero">
    <div class="about-hero-inner">
      <h1 class="about-headline reveal">Sounds that don't exist yet</h1>
      <p class="about-subhead about-valueprop reveal" data-reveal-delay="0.04s">Sonura is an ethical AI music studio. It makes royalty-free loops, vocals, one-shots, stems, and full tracks, in your browser or inside your DAW.</p>
      <p class="about-subhead reveal" data-reveal-delay="0.06s">Everyone digs through the same sample packs. With Sonura you make sounds nobody else has, and every decision stays yours.</p>
    </div>
  </section>

  <section class="plugin-section" id="what-sonura-does">
    <div>
      <h2 class="plugin-heading reveal">What Sonura does</h2>

      <div class="plugin-panel reveal" data-reveal-delay="0.06s">
        <div class="plugin-copy">
          <h3 class="plugin-name">Studio</h3>
          <p class="plugin-sub">Describe a sound and get it back in seconds</p>
          <ul class="plugin-list">
            <li><a href="/features/ai-loops/">Loops, beats, and one-shots</a></li>
            <li><a href="/features/ai-vocals/">Vocal hooks, chops, and ad-libs</a></li>
            <li><a href="/features/ai-sound-effects/">Sound effects</a></li>
            <li><a href="/tools/stem-separator/">Stems for every part, or split any track</a></li>
            <li><a href="/tools/ai-song-maker/">Full songs from ElevenLabs, Stable Audio, or Google Lyria</a></li>
          </ul>
          <a class="button primary plugin-cta" href="https://app.sonurastudio.com/">Try for free</a>
        </div>
        <div class="plugin-shot">
          <Image src={newThumbnail} alt="The Sonura studio interface generating loops and stems" />
        </div>
      </div>

      <div class="plugin-panel reveal" data-reveal-delay="0.06s">
        <div class="plugin-copy">
          <h3 class="plugin-name">Plugin</h3>
          <p class="plugin-sub">Create sounds without leaving the track</p>
          <ul class="plugin-list">
            <li>Works in Ableton, Logic, FL Studio, and five more DAWs</li>
            <li>Audition up to four takes</li>
            <li>Drag the one you want onto a track</li>
            <li>Free with your Sonura account</li>
          </ul>
          <a class="button primary plugin-cta" href="/plugin/">Get the plugin</a>
        </div>
        <div class="plugin-shot">
          <img src="/images/plugin-flow-1024.webp" alt="The Sonura Flow plugin creating a loop from a prompt" width="1024" height="768" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="artistry" id="our-ethical-approach">
    <div class="artistry-inner">
      <div class="release-positioning reveal">
        <h2 class="release-positioning-title">Our ethical approach<span class="stop">.</span></h2>
        <p class="release-positioning-text">A lot of AI music was trained on songs nobody agreed to share. Sonura is built on licensed music instead. It's made to help musicians, not replace them, and paid plans keep your work private and yours. More than 17,000 producers, artists, and creators use it today. <a href="/how-we-work-with-artists/" class="text-link">Here is how we work with artists</a>.</p>
      </div>
    </div>
  </section>

  <section class="plugin-section team-section" id="founders">
    <div>
      <h2 class="plugin-heading reveal">The team behind Sonura</h2>
      <p class="section-text reveal">We're a small team in London. We started Sonura because finding the sound in your head took hours, and the tools that promised to fix that took the creative decisions away.</p>

      <div class="team-grid">
        <div class="founder-card reveal" data-reveal-delay="0.04s">
          <div class="founder-content">
            <div class="founder-image">
              <img src="/images/kindred.jpg" alt="Kindred Salway, co-founder of Sonura" />
            </div>
            <div class="founder-info">
              <h3 class="founder-name">Kindred Salway</h3>
              <span class="founder-role">Co-founder</span>
              <div class="founder-bio">
                <p>Kindred made music for years before writing software, and kept losing hours digging for sounds. Sonura turns those hours into seconds, and leaves every decision with the person making the record.</p>
              </div>

              <div class="founder-links">
                <a href="mailto:kindred@sonurastudio.com" class="linkedin-link">
                  kindred@sonurastudio.com
                </a>
                <a href="https://x.com/kindredsalway" target="_blank" rel="noopener" class="linkedin-link">
                  Follow on X (Twitter)
                </a>
                <a href="https://www.linkedin.com/in/kindred-salway-8a05b6240/" target="_blank" rel="noopener" class="linkedin-link">
                  Connect on LinkedIn
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="founder-card reveal" data-reveal-delay="0.08s">
          <div class="founder-content">
            <div class="founder-image founder-image-static">
              <img src="/images/blue.jpg" alt="Blue Bookhard, co-founder of Sonura" />
            </div>
            <div class="founder-info">
              <h3 class="founder-name">Blue Bookhard</h3>
              <span class="founder-role">Co-founder</span>
              <div class="founder-bio">
                <p>Blue has worked with artists at TIDAL and Snapchat and writes the No Skips newsletter. Blue kept meeting people with good ideas and no way to finish them. Sonura is the tool for them.</p>
              </div>

              <div class="founder-links">
                <a href="mailto:blue@sonurastudio.com" class="linkedin-link">
                  blue@sonurastudio.com
                </a>
                <a href="https://www.instagram.com/iambluetyler/" target="_blank" rel="noopener" class="linkedin-link">
                  Follow on Instagram
                </a>
                <a href="https://www.linkedin.com/in/bluebookhard/" target="_blank" rel="noopener" class="linkedin-link">
                  Connect on LinkedIn
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="about-affiliations reveal">
        <a href="https://aiformusic.info/" target="_blank" rel="noopener" class="affiliation">
          <span class="affiliation-chip affiliation-chip-dark">
            <img src="/images/affiliations/aiformusic-wh.png" alt="AI For Music affiliation logo" loading="lazy" width="264" height="178" />
          </span>
          <span class="affiliation-name">AI For Music</span>
          <span class="affiliation-role">Supporter, Principles for Music Creation with AI</span>
        </a>
        <a href="https://musictechnology.uk/" target="_blank" rel="noopener" class="affiliation">
          <span class="affiliation-chip affiliation-chip-light">
            <img src="/images/affiliations/mtuk.png" alt="Music Technology UK affiliation logo" loading="lazy" width="264" height="190" />
          </span>
          <span class="affiliation-name">Music Technology UK</span>
          <span class="affiliation-role">Member</span>
        </a>
      </div>
    </div>
  </section>

  <section class="plugin-section" id="key-facts">
    <div>
      <h2 class="plugin-heading reveal">Key facts</h2>
      <div class="facts-wrap reveal" data-reveal-delay="0.04s">
        <table class="facts-table">
          <caption class="visually-hidden">Key facts about Sonura</caption>
          <tbody>
            {keyFacts.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td set:html={row.value} />
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="faq" id="faq" aria-labelledby="faq-title">
    <div class="faq-inner">
      <h2 id="faq-title" class="faq-title">Frequently asked questions</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="reveal">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* A photograph from a Sonura session sits behind the hero. The image is the
     ::before layer so it can be blurred and dimmed on its own, leaving the
     text crisp: a filter on the section itself would soften the type too.
     The overlay is a gradient rather than a flat wash, so the copy side stays
     dark enough to read while the right of the frame keeps some picture. */
  /* Pulled up under the sticky nav so the photo runs behind it, the way the
     homepage hero does. The padding gives the height back. */
  .about-hero {
    margin-top: calc(-1 * var(--nav-h, 70px));
    padding: calc(var(--nav-h, 70px) + clamp(96px, 14vh, 180px)) var(--page-pad) clamp(72px, 9vw, 120px);
    text-align: left;
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .about-hero::before {
    content: '';
    position: absolute;
    /* inset past the edges so the blur has material to sample and never
       feathers into a pale rim at the section boundary */
    inset: -40px;
    z-index: -2;
    background-image: url('/images/about-hero-1920.webp');
    background-position: center;
    background-size: cover;
    filter: blur(5px) saturate(0.9);
    transform: scale(1.03);
    /* feather every edge so the photo dissolves into the page instead of
       ending on a hard rectangle */
    -webkit-mask-image: radial-gradient(135% 130% at 55% 35%, #000 42%, transparent 88%);
    mask-image: radial-gradient(135% 130% at 55% 35%, #000 42%, transparent 88%);
  }

  .about-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(100deg, rgba(5, 5, 5, 0.9) 0%, rgba(5, 5, 5, 0.77) 45%, rgba(5, 5, 5, 0.46) 100%),
      linear-gradient(to bottom, rgba(5, 5, 5, 0.34) 0%, transparent 26%, rgba(5, 5, 5, 0.88) 100%);
  }

  @media (max-width: 900px) {
    /* one column, so the copy sits over the middle of the frame: flatten the
       sideways gradient into an even wash */
    .about-hero::after {
      background:
        linear-gradient(rgba(5, 5, 5, 0.82), rgba(5, 5, 5, 0.82)),
        linear-gradient(to bottom, rgba(5, 5, 5, 0.55), transparent 32%, rgba(5, 5, 5, 0.92));
    }
  }

  @media (max-width: 768px) {
    .about-hero::before {
      background-image: url('/images/about-hero-1280.webp');
    }
  }

  .about-hero-inner {
    max-width: 1100px;
    margin: 0;
  }

  /* Same rung as the landing's section headings, e.g. "Bring Sonura into your
     DAW": this is a section head, not a hero at the homepage's scale. */
  .about-headline {
    font-family: var(--font-display);
    font-size: clamp(32px, 3.95vw, 48px);
    line-height: 1;
    margin: 0 0 32px;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    font-weight: 400;
    color: var(--fg);
    text-align: left;
  }

  .about-subhead {
    font-size: 17px;
    color: var(--muted);
    line-height: 1.8;
    letter-spacing: 0.022em;
    word-spacing: 0.04em;
    margin: 0;
    max-width: 640px;
    font-weight: 400;
    text-align: left;
  }

  .about-valueprop {
    color: var(--fg);
    margin-bottom: 20px;
  }

  .section-text {
    font-size: 18px;
    color: var(--muted);
    line-height: 1.7;
    letter-spacing: 0.022em;
    margin: 0 0 56px;
    max-width: 720px;
  }

  .plugin-panel + .plugin-panel {
    margin-top: 32px;
  }

  .plugin-list a {
    color: inherit;
    text-decoration: none;
  }

  .plugin-list a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Founders side by side */
  .team-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px 64px;
  }

  .founder-content {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 32px;
    align-items: start;
  }

  .founder-image {
    aspect-ratio: 1;
    border-radius: var(--radius-panel);
    border: 1px solid var(--hairline);
    overflow: hidden;
    filter: grayscale(100%);
    transition: filter 0.5s ease;
  }

  .founder-image:hover {
    filter: grayscale(0%);
  }

  .founder-image-static:hover {
    filter: grayscale(100%);
  }

  .founder-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .founder-name {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 400;
    margin: 0 0 6px;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    line-height: 1;
    color: var(--fg);
  }

  .founder-role {
    display: block;
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 500;
  }

  .founder-bio p {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.7;
    letter-spacing: 0.022em;
    margin: 0;
  }

  .founder-links {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: center;
  }

  .linkedin-link {
    color: var(--fg);
    font-size: 13px;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .about-affiliations {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    margin-top: 56px;
  }

  .affiliation {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
    max-width: 280px;
  }

  .affiliation-chip {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 132px;
    height: 68px;
    padding: 14px 18px;
    border-radius: var(--radius-ui);
    border: 1px solid var(--hairline);
  }

  /* AI For Music logo is white, MTUK is black */
  .affiliation-chip-dark { background: #101010; }
  .affiliation-chip-light { background: #ffffff; }

  .affiliation-chip img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
  }

  .affiliation-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--fg);
    letter-spacing: 0.02em;
  }

  .affiliation:hover .affiliation-name {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .affiliation-role {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.5;
    letter-spacing: 0.022em;
  }

  .facts-wrap {
    border: 1px solid var(--hairline);
    border-radius: var(--radius-panel);
    overflow: hidden;
  }

  .facts-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
    line-height: 1.6;
    letter-spacing: 0.022em;
  }

  .facts-table th,
  .facts-table td {
    text-align: left;
    vertical-align: top;
    padding: 14px 20px;
    border-bottom: 1px solid var(--hairline);
  }

  .facts-table tr:last-child th,
  .facts-table tr:last-child td {
    border-bottom: none;
  }

  .facts-table th {
    width: 28%;
    font-weight: 600;
    color: var(--fg);
    background: var(--panel-bg);
  }

  .facts-table td {
    color: var(--muted);
  }

  .facts-table td :global(a) {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  @media (max-width: 900px) {
    .team-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  @media (max-width: 768px) {
    .about-hero {
      padding: 96px var(--page-pad) 72px;
    }

    .founder-content {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .founder-image {
      width: 160px;
    }

    /* Stack label over value so long rows never force a sideways scroll */
    .facts-table th,
    .facts-table td {
      display: block;
      width: auto;
      padding: 12px 16px;
    }

    .facts-table th {
      border-bottom: none;
      padding-bottom: 4px;
    }
  }
</style>
