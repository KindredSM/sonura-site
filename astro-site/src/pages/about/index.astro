---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/home-editorial.css";
import "../../styles/home-v2.css";

const faqs = [
    {
        q: "What is Sonura?",
        a: "An artist-led, ethical AI music studio. Our tools help music makers create royalty-free loops, vocals, one-shots, sound effects, stems, and full tracks from a text prompt, in the browser or inside their DAW.",
    },
    {
        q: "Who founded Sonura?",
        a: "Kindred Salway and Blue Bookhard, in London.",
    },
    {
        q: "Is Sonura free?",
        a: "Yes. You get 20 credits when you sign up and more each day, with no card needed. Starter, Pro, and Max add more credits.",
    },
    {
        q: "Do I own what I make?",
        a: "On paid plans, yes. Your work stays private and yours to sell and release, with no royalty splits. Free plan work is public by default and released under CC0.",
    },
    {
        q: "What makes Sonura ethical?",
        a: "It is built on licensed music, not scraped catalogs, and it gives you editable parts rather than a finished song, so the creative decisions stay with you.",
    },
    {
        q: "Does Sonura work in my DAW?",
        a: "Yes. Sonura Flow is a free VST3 and AU plugin for Ableton Live, Logic Pro, FL Studio, Studio One, Bitwig, Cubase, Reaper, and GarageBand, on Mac and Windows.",
    },
    {
        q: "How is Sonura different from Suno?",
        a: "Suno makes finished songs. Sonura makes parts you can edit, with stems on every plan and a plugin that puts them straight into your DAW.",
    },
    {
        q: "Can I cancel anytime?",
        a: "Yes. Plans are month to month. Cancel in settings and you keep access until the billing period ends.",
    },
];

const keyFacts = [
    { label: "Company", value: '<a href="/">Sonura</a> (Sonura Studio)' },
    {
        label: "Founders",
        value: '<a href="https://www.linkedin.com/in/kindred-salway-8a05b6240/" target="_blank" rel="noopener">Kindred Salway</a> and <a href="https://www.linkedin.com/in/bluebookhard/" target="_blank" rel="noopener">Blue Bookhard</a>',
    },
    { label: "Based in", value: "London, UK" },
    {
        label: "What it makes",
        value: '<a href="/features/ai-loops/">Loops</a>, <a href="/features/ai-vocals/">vocals</a>, one-shots, <a href="/features/ai-sound-effects/">sound effects</a>, <a href="/tools/stem-separator/">stems</a>, and <a href="/tools/ai-song-maker/">full tracks</a>',
    },
    {
        label: "Products",
        value: '<a href="https://app.sonurastudio.com/">Web studio</a>, <a href="/plugin/">Sonura Flow plugin</a>, <a href="/tools/stem-separator/">Sonura Split</a>, <a href="/tools/">free tools</a>',
    },
    {
        label: "Works with",
        value: 'Ableton Live, Logic Pro, FL Studio, Studio One, Bitwig, Cubase, Reaper, GarageBand, via the <a href="/plugin/">Sonura Flow plugin</a>',
    },
    {
        label: "Pricing",
        value: 'Free plan, plus Starter, Pro, and Max. <a href="/pricing/">See pricing</a>',
    },
    {
        label: "Rights",
        value: 'Paid plans: private and yours, no royalty splits. Free plan and public work: CC0. <a href="/terms/">Terms</a>',
    },
    {
        label: "Training data",
        value: 'Licensed, not scraped. <a href="/how-we-work-with-artists/">How we work with artists</a>',
    },
    {
        label: "Support",
        value: 'Email <a href="mailto:kindred@sonurastudio.com">kindred@sonurastudio.com</a> or ask in <a href="https://discord.com/invite/Yk8RD3Nmyh" target="_blank" rel="noopener">Discord</a>',
    },
    {
        label: "Affiliations",
        value: 'Member, <a href="https://musictechnology.uk/" target="_blank" rel="noopener">Music Technology UK</a>. Supporter, <a href="https://aiformusic.info/" target="_blank" rel="noopener">AI For Music</a> principles',
    },
    {
        label: "Alternatives to",
        value: '<a href="/alternatives/suno-alternative/">Suno</a>, <a href="/alternatives/udio-alternative/">Udio</a>, <a href="/alternatives/splice-alternative/">Splice</a>, <a href="/alternatives/soundraw-alternative/">Soundraw</a>, <a href="/alternatives/aiva-alternative/">AIVA</a>, <a href="https://moises.ai/" target="_blank" rel="noopener">Moises</a>, <a href="/blog/waves-illugen-vs-sonura/">Waves Illugen</a>',
    },
];

const orgId = "https://sonurastudio.com/#organization";

const jsonLd = [
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        "@id": orgId,
        name: "Sonura",
        alternateName: "Sonura Studio",
        url: "https://sonurastudio.com/",
        logo: "https://sonurastudio.com/demo-image.jpeg",
        description:
            "Sonura is an artist-led, ethical AI music studio. Our tools help music makers create royalty-free loops, vocals, one-shots, sound effects, stems, and full tracks, built on licensed music, in the browser or inside their DAW.",
        address: {
            "@type": "PostalAddress",
            addressLocality: "London",
            addressCountry: "GB",
        },
        founder: [
            {
                "@type": "Person",
                name: "Kindred Salway",
                jobTitle: "Co-founder",
                sameAs: [
                    "https://www.linkedin.com/in/kindred-salway-8a05b6240/",
                    "https://x.com/kindredsalway",
                ],
            },
            {
                "@type": "Person",
                name: "Blue Bookhard",
                jobTitle: "Co-founder",
                sameAs: [
                    "https://www.linkedin.com/in/bluebookhard/",
                    "https://www.instagram.com/iambluetyler/",
                ],
            },
        ],
        memberOf: [
            {
                "@type": "Organization",
                name: "Music Technology UK",
                url: "https://musictechnology.uk/",
            },
        ],
        sameAs: [
            "https://twitter.com/sonurastudio",
            "https://www.instagram.com/sonurastudio/",
            "https://discord.com/invite/Yk8RD3Nmyh",
        ],
        contactPoint: {
            "@type": "ContactPoint",
            email: "kindred@sonurastudio.com",
            contactType: "Customer Support",
            availableLanguage: "English",
        },
    },
    {
        "@context": "https://schema.org",
        "@type": "AboutPage",
        name: "About Sonura",
        url: "https://sonurastudio.com/about/",
        description:
            "What Sonura is, who makes it, and the key facts about the company.",
        mainEntity: { "@id": orgId },
    },
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqs.map((f) => ({
            "@type": "Question",
            name: f.q,
            acceptedAnswer: { "@type": "Answer", text: f.a },
        })),
    },
];
---

<BaseLayout
    title="About Sonura | The Artist-Led, Ethical AI Music Studio"
    description="Sonura is an artist-led, ethical AI music studio. Our tools help music makers create loops, vocals, stems, and full tracks in the browser or DAW."
    keywords="about sonura, sonura studio, ethical ai music studio, artist-led ai music, ai music company, kindred salway, blue bookhard, sonura founders"
    canonical="https://sonurastudio.com/about/"
    ogTitle="About Sonura - The Artist-Led, Ethical AI Music Studio"
    ogDescription="Who makes Sonura, and why."
    jsonLd={jsonLd}
    bodyClass="editorial-home home-v2"
>
    <section class="about-hero">
        <div class="about-hero-inner">
            <h1 class="about-headline reveal">Sounds that don't exist yet</h1>
            <p
                class="about-subhead about-valueprop reveal"
                data-reveal-delay="0.04s"
            >
                Sonura is an artist-led, ethical AI music studio. Our tools
                help music makers create loops, vocals, one-shots, stems, and
                full tracks, in the browser or inside their DAW.
            </p>
        </div>
    </section>

    <section class="plugin-section" id="why-we-started">
        <div class="story">
            <div class="story-text">
                <h2 class="plugin-heading reveal">Why we started Sonura</h2>
                <p class="section-text reveal">
                    We're musicians first. Finding the sound in our heads took
                    hours of digging through packs, and the tools that promised
                    to fix that wanted to make the whole song for us.
                </p>
                <p class="section-text reveal">
                    We wanted the opposite. Something that gets you to the sound
                    fast, then gets out of the way, so the record is still yours.
                </p>
            </div>
            <div class="story-media reveal" data-reveal-delay="0.06s">
                <video
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    poster="/images/about-studio-poster.webp"
                    aria-label="Kindred working in the studio"
                >
                    <source src="/videos/about-studio.webm" type="video/webm" />
                    <source src="/videos/about-studio.mp4" type="video/mp4" />
                </video>
            </div>
        </div>
    </section>

    <section class="plugin-section" id="what-we-believe">
        <h2 class="plugin-heading reveal">What we believe</h2>
        <div class="beliefs">
            <div class="belief reveal">
                <h3>Artists first</h3>
                <p>
                    We make the tools we want in our own sessions. If it doesn't
                    help someone make a better record, we don't build it.
                </p>
            </div>
            <div class="belief reveal" data-reveal-delay="0.04s">
                <h3>Licensed, not scraped</h3>
                <p>
                    A lot of AI music was trained on songs nobody agreed to
                    share. Sonura is built on licensed music instead.
                </p>
            </div>
            <div class="belief reveal" data-reveal-delay="0.08s">
                <h3>Tools, not replacements</h3>
                <p>
                    Sonura gives you parts to shape, not a stand-in for your
                    taste. Even full tracks split into stems you can take apart.
                </p>
            </div>
            <div class="belief reveal" data-reveal-delay="0.12s">
                <h3>Your work is yours</h3>
                <p>
                    On paid plans what you make stays private and yours to
                    release, with no royalty splits.
                </p>
            </div>
        </div>
    </section>

    <section class="plugin-section" id="how-we-build">
        <div class="story">
            <div class="story-text">
                <h2 class="plugin-heading reveal">How we build</h2>
                <p class="section-text reveal">
                    We only build on music that was licensed for it, and we
                    hold ourselves to the same standards as the groups we've
                    joined.
                    <a href="/how-we-work-with-artists/" class="text-link"
                        >How we work with artists</a
                    >
                </p>
            </div>
            <div class="about-affiliations reveal" data-reveal-delay="0.06s">
                <a
                    href="https://musictechnology.uk/"
                    target="_blank"
                    rel="noopener"
                    class="affiliation"
                >
                    <span class="affiliation-chip affiliation-chip-light">
                        <img
                            src="/images/affiliations/mtuk.png"
                            alt="Music Technology UK logo"
                            loading="lazy"
                            width="264"
                            height="190"
                        />
                    </span>
                    <span class="affiliation-info">
                        <span class="affiliation-name">Music Technology UK</span>
                        <span class="affiliation-role">Member</span>
                    </span>
                </a>
                <a
                    href="https://aiformusic.info/"
                    target="_blank"
                    rel="noopener"
                    class="affiliation"
                >
                    <span class="affiliation-chip affiliation-chip-dark">
                        <img
                            src="/images/affiliations/aiformusic-wh.png"
                            alt="AI For Music logo"
                            loading="lazy"
                            width="264"
                            height="178"
                        />
                    </span>
                    <span class="affiliation-info">
                        <span class="affiliation-name">AI For Music</span>
                        <span class="affiliation-role"
                            >Supporter, Principles for Music Creation with AI</span
                        >
                    </span>
                </a>
            </div>
        </div>
    </section>

    <section class="plugin-section team-section" id="founders">
        <div>
            <h2 class="plugin-heading reveal">The team behind Sonura</h2>
            <p class="section-text reveal">We're a small team in London.</p>

            <div class="team-grid">
                <div class="founder-card reveal" data-reveal-delay="0.04s">
                    <div class="founder-content">
                        <div class="founder-image">
                            <img
                                src="/images/kindred.jpg"
                                alt="Kindred Salway, co-founder of Sonura"
                            />
                        </div>
                        <div class="founder-info">
                            <h3 class="founder-name">Kindred Salway</h3>
                            <span class="founder-role">Co-founder</span>
                            <div class="founder-bio">
                                <p>
                                    Kindred made music for years before writing
                                    software, and kept losing hours digging for
                                    sounds. Sonura turns those hours into
                                    seconds, and leaves every decision with the
                                    person making the record.
                                </p>
                            </div>

                            <div class="founder-links">
                                <a
                                    href="mailto:kindred@sonurastudio.com"
                                    class="linkedin-link"
                                >
                                    kindred@sonurastudio.com
                                </a>
                                <a
                                    href="https://x.com/kindredsalway"
                                    target="_blank"
                                    rel="noopener"
                                    class="linkedin-link"
                                >
                                    Follow on X (Twitter)
                                </a>
                                <a
                                    href="https://www.linkedin.com/in/kindred-salway-8a05b6240/"
                                    target="_blank"
                                    rel="noopener"
                                    class="linkedin-link"
                                >
                                    Connect on LinkedIn
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="founder-card reveal" data-reveal-delay="0.08s">
                    <div class="founder-content">
                        <div class="founder-image founder-image-static">
                            <img
                                src="/images/blue.jpg"
                                alt="Blue Bookhard, co-founder of Sonura"
                            />
                        </div>
                        <div class="founder-info">
                            <h3 class="founder-name">Blue Bookhard</h3>
                            <span class="founder-role">Co-founder</span>
                            <div class="founder-bio">
                                <p>
                                    Blue has worked with artists at TIDAL and
                                    Snapchat and writes the No Skips newsletter.
                                    Blue kept meeting people with good ideas and
                                    no way to finish them. Sonura is the tool
                                    for them.
                                </p>
                            </div>

                            <div class="founder-links">
                                <a
                                    href="mailto:blue@sonurastudio.com"
                                    class="linkedin-link"
                                >
                                    blue@sonurastudio.com
                                </a>
                                <a
                                    href="https://www.instagram.com/iambluetyler/"
                                    target="_blank"
                                    rel="noopener"
                                    class="linkedin-link"
                                >
                                    Follow on Instagram
                                </a>
                                <a
                                    href="https://www.linkedin.com/in/bluebookhard/"
                                    target="_blank"
                                    rel="noopener"
                                    class="linkedin-link"
                                >
                                    Connect on LinkedIn
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <section class="plugin-section" id="what-sonura-does">
        <div class="story">
            <div class="story-text">
                <h2 class="plugin-heading reveal">What we make</h2>
                <p class="section-text reveal">
                    A full studio in your browser. Make loops, one-shots, vocals
                    and sound effects, arrange them in a full DAW, write whole
                    songs in songs mode, and split any track into stems.
                </p>
                <p class="section-text reveal">
                    Sonura Flow brings the same tools into Ableton, Logic, FL
                    Studio and five more DAWs.
                </p>
            </div>
            <div class="story-media reveal" data-reveal-delay="0.06s">
                <video
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    poster="/images/sonura-flow-demo-poster.webp"
                    aria-label="Sonura Flow creating drums inside a DAW"
                >
                    <source src="/videos/sonura-flow-demo.webm" type="video/webm" />
                    <source src="/videos/sonura-flow-demo.mp4" type="video/mp4" />
                </video>
            </div>
        </div>
    </section>

    <section class="plugin-section" id="key-facts">
        <div>
            <h2 class="plugin-heading reveal">Key facts</h2>
            <div class="facts-wrap reveal" data-reveal-delay="0.04s">
                <table class="facts-table">
                    <caption class="visually-hidden">
                        Key facts about Sonura
                    </caption>
                    <tbody>
                        {keyFacts.map((row) => (
                            <tr>
                                <th scope="row">{row.label}</th>
                                <td set:html={row.value} />
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="faq" id="faq" aria-labelledby="faq-title">
        <div class="faq-inner">
            <h2 id="faq-title" class="faq-title">
                Frequently asked questions
            </h2>
            <div class="faq-list">
                {faqs.map((f) => (
                    <details class="reveal">
                        <summary>{f.q}</summary>
                        <p>{f.a}</p>
                    </details>
                ))}
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .about-hero {
        margin-top: calc(-1 * var(--nav-h, 70px));
        padding: calc(var(--nav-h, 70px) + clamp(96px, 14vh, 180px))
            var(--page-pad) clamp(72px, 9vw, 120px);
        text-align: left;
        position: relative;
        isolation: isolate;
        overflow: hidden;
    }

    .about-hero::before {
        content: "";
        position: absolute;
        inset: -40px;
        z-index: -2;
        background-image: url("/images/about-hero-1920.webp");
        background-position: center;
        background-size: cover;
        filter: blur(5px) saturate(0.9);
        transform: scale(1.03);
        -webkit-mask-image: linear-gradient(to bottom, #000 35%, transparent 80%);
        mask-image: linear-gradient(to bottom, #000 35%, transparent 80%);
    }

    .about-hero::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background:
            linear-gradient(
                100deg,
                rgba(5, 5, 5, 0.9) 0%,
                rgba(5, 5, 5, 0.77) 45%,
                rgba(5, 5, 5, 0.46) 100%
            ),
            linear-gradient(
                to bottom,
                rgba(5, 5, 5, 0.34) 0%,
                transparent 26%
            );
        -webkit-mask-image: linear-gradient(to bottom, #000 35%, transparent 80%);
        mask-image: linear-gradient(to bottom, #000 35%, transparent 80%);
    }

    @media (max-width: 900px) {
        .about-hero::after {
            background:
                linear-gradient(rgba(5, 5, 5, 0.82), rgba(5, 5, 5, 0.82)),
                linear-gradient(
                    to bottom,
                    rgba(5, 5, 5, 0.55),
                    transparent 32%,
                    rgba(5, 5, 5, 0.92)
                );
        }
    }

    @media (max-width: 768px) {
        .about-hero::before {
            background-image: url("/images/about-hero-1280.webp");
        }
    }

    .about-hero-inner {
        max-width: none;
        margin: 0;
    }

    .about-headline {
        font-family: var(--font-display);
        font-size: clamp(52px, 8.4vw, 104px);
        line-height: 1.02;
        margin: 0 0 32px;
        letter-spacing: 0.01em;
        text-transform: uppercase;
        font-weight: 400;
        color: var(--fg);
        text-align: left;
    }

    .about-subhead {
        font-size: 22px;
        color: var(--muted);
        line-height: 1.5;
        letter-spacing: 0.022em;
        margin: 0;
        max-width: 720px;
        font-weight: 400;
        text-align: left;
    }

    .about-valueprop {
        color: var(--fg);
    }

    .section-text {
        font-size: 18px;
        color: var(--muted);
        line-height: 1.5;
        letter-spacing: 0.022em;
        margin: 0 0 56px;
        max-width: 720px;
    }

    .story {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: clamp(32px, 6vw, 96px);
        align-items: center;
    }

    .story .section-text {
        margin-bottom: 20px;
    }

    .story .section-text:last-child {
        margin-bottom: 0;
    }

    .story-media {
        justify-self: end;
        width: 100%;
        max-width: 520px;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border: 1px solid var(--hairline);
    }

    .story-media video {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .beliefs {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 40px 72px;
    }

    .belief h3 {
        margin: 0 0 10px;
        font-size: 18px;
        font-weight: 700;
        line-height: 1.4;
        letter-spacing: 0.02em;
        color: var(--fg);
    }

    .belief p {
        margin: 0;
        max-width: 520px;
        font-size: 18px;
        line-height: 1.5;
        letter-spacing: 0.022em;
        color: var(--muted);
    }


    .team-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 64px 96px;
    }

    .founder-content {
        display: flex;
        flex-direction: column;
        gap: 28px;
        max-width: 520px;
    }

    .founder-image {
        width: 220px;
        aspect-ratio: 1;
        border-radius: var(--radius-panel);
        border: 1px solid var(--hairline);
        overflow: hidden;
        filter: grayscale(100%);
        transition: filter 0.5s ease;
    }

    .founder-image:hover {
        filter: grayscale(0%);
    }

    .founder-image-static:hover {
        filter: grayscale(100%);
    }

    .founder-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .founder-name {
        margin: 0 0 6px;
        font-size: 18px;
        font-weight: 700;
        line-height: 1.4;
        letter-spacing: 0.02em;
        color: var(--fg);
    }

    .founder-role {
        display: block;
        font-size: 12px;
        color: var(--muted);
        margin-bottom: 20px;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-weight: 500;
    }

    .founder-bio p {
        font-size: 18px;
        color: var(--muted);
        line-height: 1.5;
        letter-spacing: 0.022em;
        margin: 0;
    }

    .founder-links {
        margin-top: 24px;
        display: flex;
        flex-wrap: wrap;
        gap: 12px 24px;
        align-items: center;
    }

    .linkedin-link {
        color: var(--fg);
        font-size: 14px;
        font-weight: 600;
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 5px;
    }

    .about-affiliations {
        display: flex;
        flex-direction: column;
    }

    .affiliation {
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 24px 0;
        text-decoration: none;
    }

    .affiliation:first-child {
        padding-top: 0;
    }

    .affiliation:last-child {
        padding-bottom: 0;
    }

    .affiliation + .affiliation {
        border-top: 1px solid var(--hairline);
    }

    .affiliation-info {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .affiliation-chip {
        flex: none;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 120px;
        height: 64px;
        padding: 12px 16px;
        border: 1px solid var(--hairline);
    }

    .affiliation-chip-dark {
        background: #101010;
    }
    .affiliation-chip-light {
        background: #ffffff;
    }

    .affiliation-chip img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
