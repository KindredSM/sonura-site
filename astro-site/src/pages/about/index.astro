---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import newThumbnail from '../../assets/images/new-thumbnail.jpg';

// One list feeds both the visible FAQ and the FAQPage schema, so the two
// can't drift apart. Answers are plain text: the schema gets them verbatim.
const faqs = [
  {
    q: 'What is Sonura?',
    a: 'Sonura is an AI music studio that generates royalty-free loops, vocals, one-shots, sound effects, stems, and full tracks. It runs in the browser and as the Sonura Flow VST3 and AU plugin inside your DAW. It returns parts you can edit, not finished songs you can only play.',
  },
  {
    q: 'Who founded Sonura?',
    a: 'Sonura was founded by Kindred Salway and Blue Bookhard. Kindred is a musician turned software builder; Blue has worked with artists at TIDAL and Snapchat and writes the No Skips music newsletter.',
  },
  {
    q: 'Where is Sonura based?',
    a: 'Sonura is based in London, United Kingdom. It is a member of Music Technology UK and a supporter of the AI For Music principles for music creation with AI.',
  },
  {
    q: 'Is Sonura free?',
    a: 'Yes. The free plan gives you 20 credits on signup plus a daily allowance, with the full studio and no credit card. Paid plans start at $10 a month (Starter), with Pro at $20 and Max at $45, or 20% less billed yearly.',
  },
  {
    q: 'Do I own what I make with Sonura?',
    a: 'On every paid plan you keep exclusive commercial rights to what you create, with no royalty splits. Free plan creations are released as public domain (CC0), so upgrade if you need them to be exclusively yours.',
  },
  {
    q: 'Is Sonura trained on licensed music?',
    a: 'Yes. Sonura is trained on licensed music data, not scraped catalogs. That keeps what you make on solid commercial ground when you release or sell it.',
  },
  {
    q: 'Does Sonura work inside my DAW?',
    a: 'Yes. Sonura Flow is a free VST3 and AU plugin for Ableton Live, Logic Pro, FL Studio, Studio One, Bitwig, Cubase, Reaper, and GarageBand on macOS and Windows. Generations use the same credits as your Sonura account.',
  },
  {
    q: 'How is Sonura different from Suno?',
    a: 'Suno is built to produce finished songs, and its stem export (up to 12 stems) sits inside Suno Studio on its top plan. Sonura is built around parts: stem splitting is on every plan including free, and everything drops straight into your DAW through the plugin.',
  },
  {
    q: 'Can I cancel my Sonura subscription anytime?',
    a: 'Yes. Every plan is month-to-month with no contract. Cancel from your account settings and you keep access until the end of the billing period.',
  },
];

// Key facts, rendered as a real <table> so crawlers and AI answer engines
// can read each row as a labelled fact. Values may carry inline links.
const keyFacts = [
  { label: 'Company name', value: 'Sonura (operated as Sonura Studio)' },
  { label: 'Type', value: 'AI music studio: web app and VST3/AU DAW plugin' },
  { label: 'Founders', value: 'Kindred Salway and Blue Bookhard (co-founders)' },
  { label: 'Headquarters', value: 'London, United Kingdom' },
  { label: 'Website', value: '<a href="https://sonurastudio.com/">sonurastudio.com</a>' },
  { label: 'Core offering', value: 'Royalty-free loops, vocals, one-shots, sound effects, stems, and full tracks, generated from a text prompt in under 10 seconds on average' },
  { label: 'Pricing', value: 'Free ($0, daily credits), Starter $10/mo, Pro $20/mo, Max $45/mo. Annual billing saves 20%. <a href="/pricing/">See pricing</a>' },
  { label: 'Contract terms', value: 'Month-to-month, no contracts, cancel anytime. Access continues to the end of the billing period' },
  { label: 'Rights', value: 'Exclusive commercial rights with no royalty splits on paid plans. Free plan output is public domain (CC0)' },
  { label: 'Training data', value: 'Licensed music data, not scraped catalogs. <a href="/how-we-work-with-artists/">How we work with artists</a>' },
  { label: 'Products and services', value: 'Sonura web studio, <a href="/plugin/">Sonura Flow plugin</a> (VST3/AU), Sonura Split stem separator, <a href="/tools/">free tools</a> (beat maker, vocal remover, acapella extractor, BPM tap tempo, and more)' },
  { label: 'Supported DAWs', value: 'Ableton Live, Logic Pro, FL Studio, Studio One, Bitwig, Cubase, Reaper, GarageBand' },
  { label: 'Communication', value: 'Email (replies within 24 hours), Discord community, priority 24/7 support on Pro and Max, one-to-one calls on Max' },
  { label: 'Customers served', value: '17,000+ producers, artists, and creators' },
  { label: 'Affiliations', value: 'Member, Music Technology UK. Supporter, AI For Music principles' },
  { label: 'Competitors', value: '<a href="/alternatives/suno-alternative/">Suno</a>, <a href="/alternatives/udio-alternative/">Udio</a>, <a href="/compare/elevenlabs-vs-suno/">ElevenLabs Music</a>, <a href="/compare/mureka-vs-suno/">Mureka</a>, <a href="/compare/lyria-vs-suno/">Google Lyria</a>, <a href="/alternatives/splice-alternative/">Splice</a>, <a href="/alternatives/soundraw-alternative/">Soundraw</a>, <a href="/alternatives/beatoven-alternative/">Beatoven.ai</a>, <a href="/alternatives/aiva-alternative/">AIVA</a>' },
  { label: 'Social', value: '<a href="https://twitter.com/sonurastudio" target="_blank" rel="noopener">X (@sonurastudio)</a>, <a href="https://www.instagram.com/sonurastudio/" target="_blank" rel="noopener">Instagram</a>, <a href="https://discord.com/invite/Yk8RD3Nmyh" target="_blank" rel="noopener">Discord</a>' },
];

const orgId = 'https://sonurastudio.com/#organization';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": orgId,
    "name": "Sonura",
    "alternateName": "Sonura Studio",
    "url": "https://sonurastudio.com/",
    "logo": "https://sonurastudio.com/demo-image.jpeg",
    "description": "Sonura is an AI music studio that generates royalty-free loops, vocals, one-shots, sound effects, stems, and full tracks for music producers, artists, and creators, on the web or inside their DAW.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "London",
      "addressCountry": "GB"
    },
    "founder": [
      {
        "@type": "Person",
        "name": "Kindred Salway",
        "jobTitle": "Co-founder",
        "sameAs": [
          "https://www.linkedin.com/in/kindred-salway-8a05b6240/",
          "https://x.com/kindredsalway"
        ]
      },
      {
        "@type": "Person",
        "name": "Blue Bookhard",
        "jobTitle": "Co-founder",
        "sameAs": [
          "https://www.linkedin.com/in/bluebookhard/",
          "https://www.instagram.com/iambluetyler/"
        ]
      }
    ],
    "memberOf": [
      { "@type": "Organization", "name": "Music Technology UK", "url": "https://musictechnology.uk/" }
    ],
    "sameAs": [
      "https://twitter.com/sonurastudio",
      "https://www.instagram.com/sonurastudio/",
      "https://discord.com/invite/Yk8RD3Nmyh"
    ],
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "kindred@sonurastudio.com",
      "contactType": "Customer Support",
      "availableLanguage": "English"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "About Sonura",
    "url": "https://sonurastudio.com/about/",
    "description": "What Sonura is, what it does, what makes it different, who uses it, the team behind it, and the key facts about the company.",
    "mainEntity": { "@id": orgId }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }
];
---

<BaseLayout
  title="About Sonura | The AI Music Studio for Producers"
  description="Sonura is an AI music studio for producers: royalty-free loops, vocals, stems, and full tracks, on the web or in your DAW."
  keywords="about sonura, sonura studio, ai music studio, ai music company, kindred salway, blue bookhard, sonura founders"
  canonical="https://sonurastudio.com/about/"
  ogTitle="About Sonura - The AI Music Studio for Producers"
  ogDescription="What Sonura does, what makes it different, and the team behind it."
  jsonLd={jsonLd}
>
  <section class="about-hero">
    <div class="about-hero-inner">
      <p class="section-kicker reveal">About Sonura</p>
      <h1 class="about-headline reveal">Sounds that don't exist yet</h1>
      <p class="about-subhead about-valueprop reveal" data-reveal-delay="0.04s">Sonura is an AI music studio that generates royalty-free loops, vocals, one-shots, stems, and full tracks for music producers, artists, and creators, on the web or inside their DAW.</p>
      <p class="about-subhead reveal" data-reveal-delay="0.06s">Everyone pulls from the same packs. Sonura makes new sounds instead: original audio you can shape in seconds, while every creative decision stays yours.</p>
    </div>
  </section>

  <section class="about-section" id="what-sonura-does">
    <div class="about-section-inner">
      <h2 class="section-title reveal">What Sonura does</h2>
      <div class="product-grid">
        <div class="product-image synth-panel reveal" data-reveal-delay="0.04s">
          <Image
            src={newThumbnail}
            alt="The Sonura studio interface generating loops and stems"
            style="width: 100%; height: auto; display: block;"
          />
        </div>
        <div class="card-list reveal" data-reveal-delay="0.08s">
          <div class="card-item">
            <h3>Loops, beats, and one-shots</h3>
            <p>Describe a sound and get drum, bass, and melody loops, full beats, or one-shots back in seconds. Every result is generated for your prompt, so it isn't sitting in anyone else's sample folder. <a href="/features/ai-loops/" class="text-link">AI loops</a></p>
          </div>
          <div class="card-item">
            <h3>AI vocals</h3>
            <p>Generate vocal chops, hooks, ad-libs, and sung phrases that fit your track. Useful when a record needs a topline idea and there's no singer in the room. <a href="/features/ai-vocals/" class="text-link">AI vocals</a></p>
          </div>
          <div class="card-item">
            <h3>Sound effects</h3>
            <p>Risers, impacts, drops, textures, and atmospheres for transitions, game audio, and video. You build a custom FX library instead of recycling the same stock hits. <a href="/features/ai-sound-effects/" class="text-link">AI sound effects</a></p>
          </div>
          <div class="card-item">
            <h3>Stem export and Sonura Split</h3>
            <p>Export drums, bass, melody, FX, and vocals as separate stems, or split any existing track with Sonura Split. You mix and arrange the parts in your DAW with full control. <a href="/tools/stem-separator/" class="text-link">Stem separator</a></p>
          </div>
          <div class="card-item">
            <h3>Sonura Flow, the DAW plugin</h3>
            <p>A free VST3 and AU plugin that brings generation inside Ableton Live, Logic Pro, FL Studio, and five more DAWs. You prompt, audition up to four variations, and drag the one you want onto a track without leaving the session. <a href="/plugin/" class="text-link">Sonura Flow</a></p>
          </div>
          <div class="card-item">
            <h3>Full tracks</h3>
            <p>When you need a complete reference or a finished bed, songs mode generates full tracks and lets you pick from models including ElevenLabs, Stable Audio, MiniMax, and Google Lyria. Any result can still be split into stems for your mix. <a href="/tools/ai-song-maker/" class="text-link">AI song maker</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="about-section" id="what-makes-sonura-different">
    <div class="about-section-inner">
      <h2 class="section-title reveal">What makes Sonura different</h2>
      <div class="diff-grid">
        <div class="diff-item reveal">
          <h3>Stems on every plan, including free</h3>
          <p>Sonura splits tracks into stems on every plan, free included. Suno keeps its stem export (up to 12 stems) inside Suno Studio on its top plan, and Google Lyria, MiniMax, and ElevenLabs Music don't export stems at all.</p>
        </div>
        <div class="diff-item reveal" data-reveal-delay="0.04s">
          <h3>Trained on licensed music, not scraped catalogs</h3>
          <p>Sonura's models are trained on licensed music data. Suno has a licensing deal with Warner Music while other label litigation is unresolved, and Mureka and MiniMax don't disclose their training data at all. What you make here is cleared to release and sell.</p>
        </div>
        <div class="diff-item reveal" data-reveal-delay="0.08s">
          <h3>Parts you own, not songs you can only play</h3>
          <p>Every paid plan gives you exclusive commercial rights with no royalty splits. Boomy runs on a revenue-share model, and Udio has switched off audio, stem, and video downloads entirely. On Sonura you download the file and it's yours.</p>
        </div>
        <div class="diff-item reveal" data-reveal-delay="0.04s">
          <h3>Built for your DAW, not a browser tab</h3>
          <p>Sonura Flow runs as a VST3 and AU plugin in eight DAWs, so generation happens where the track is. Suno is a web and mobile app, and Google Lyria lives in Vertex AI and Google Flow, which suits products more than sessions.</p>
        </div>
        <div class="diff-item reveal" data-reveal-delay="0.08s">
          <h3>New sounds in under 10 seconds, month to month</h3>
          <p>Loops land in 5 to 8 seconds and full tracks in 8 to 12, where Udio takes 30 to 60 seconds and Beatoven.ai 1 to 3 minutes. Every plan is month-to-month from $10, and Splice's shared catalog of pre-made samples is replaced by sounds generated for your prompt alone.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="about-section" id="who-uses-sonura">
    <div class="about-section-inner">
      <h2 class="section-title reveal">Who uses Sonura</h2>
      <p class="section-text reveal">More than 17,000 producers, artists, and creators use Sonura. Most of them fall into one of these groups:</p>
      <ul class="icp-list reveal" data-reveal-delay="0.04s">
        <li>Independent producers and beatmakers working in Ableton Live, Logic Pro, or FL Studio who want new loops and one-shots without digging through sample packs</li>
        <li>Type beat producers who lease and sell instrumentals and need exclusive rights with no royalty splits</li>
        <li>Independent artists and songwriters who need vocal hooks, chops, and ad-libs to sketch toplines</li>
        <li>Sound designers and sample pack makers building original libraries from generated one-shots and FX</li>
        <li>Content creators, podcasters, and video editors who need royalty-free music beds and sound effects</li>
        <li>Indie game developers and filmmakers scoring projects without a composer budget</li>
        <li>Small studios and production teams on the Max plan who need volume, priority support, and one-to-one calls</li>
      </ul>
    </div>
  </section>

  <section class="about-section team-section" id="founders">
    <div class="about-section-inner">
      <h2 class="section-title reveal">The team behind Sonura</h2>
      <p class="section-text reveal">Sonura started because both founders kept hitting the same wall: the sound in your head is hours of digging away from the track, and the tools that promise to close that gap mostly take the creative decisions away from you. It's a small, founder-led team in London, and the founders still answer support themselves.</p>

      <div class="team-grid">
        <div class="founder-card reveal" data-reveal-delay="0.04s">
          <div class="founder-content">
            <div class="founder-image">
              <img src="/images/kindred.jpg" alt="Kindred Salway, co-founder of Sonura" />
            </div>
            <div class="founder-info">
              <h3 class="founder-name">Kindred Salway</h3>
              <span class="founder-role">Co-founder</span>
              <div class="founder-bio">
                <p>Kindred has been making music since long before he was writing software, and kept running into the same wall: the sound in his head was always three hours of digging away from the track. He built Sonura so that gap closes to seconds, and so the decisions that actually matter stay with the person making the record.</p>
              </div>

              <div class="founder-links">
                <a href="mailto:kindred@sonurastudio.com" class="linkedin-link">
                  kindred@sonurastudio.com
                </a>
                <span class="separator">|</span>
                <a href="https://x.com/kindredsalway" target="_blank" rel="noopener" class="linkedin-link">
                  Follow on X (Twitter)
                </a>
                <span class="separator">|</span>
                <a href="https://www.linkedin.com/in/kindred-salway-8a05b6240/" target="_blank" rel="noopener" class="linkedin-link">
                  Connect on LinkedIn
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="founder-card reveal" data-reveal-delay="0.08s">
          <div class="founder-content">
            <div class="founder-image founder-image-static">
              <img src="/images/blue.jpg" alt="Blue Bookhard, co-founder of Sonura" />
            </div>
            <div class="founder-info">
              <h3 class="founder-name">Blue Bookhard</h3>
              <span class="founder-role">Co-founder</span>
              <div class="founder-bio">
                <p>Blue has spent his career around artists, at TIDAL, at Snapchat, and writing about music every week at No Skips. He kept meeting people with real ideas and no route to finishing them. Sonura is the tool he wanted to hand those people: everything you need to make the thing, and none of the gatekeeping.</p>
              </div>

              <div class="founder-links">
                <a href="mailto:blue@sonurastudio.com" class="linkedin-link">
                  blue@sonurastudio.com
                </a>
                <span class="separator">|</span>
                <a href="https://www.instagram.com/iambluetyler/" target="_blank" rel="noopener" class="linkedin-link">
                  Follow on Instagram
                </a>
                <span class="separator">|</span>
                <a href="https://www.linkedin.com/in/bluebookhard/" target="_blank" rel="noopener" class="linkedin-link">
                  Connect on LinkedIn
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="about-affiliations reveal">
        <a href="https://aiformusic.info/" target="_blank" rel="noopener" class="affiliation">
          <span class="affiliation-chip affiliation-chip-dark">
            <img src="/images/affiliations/aiformusic-wh.png" alt="AI For Music affiliation logo" loading="lazy" width="264" height="178" />
          </span>
          <span class="affiliation-name">AI For Music</span>
          <span class="affiliation-role">Supporter, Principles for Music Creation with AI</span>
        </a>
        <a href="https://musictechnology.uk/" target="_blank" rel="noopener" class="affiliation">
          <span class="affiliation-chip affiliation-chip-light">
            <img src="/images/affiliations/mtuk.png" alt="Music Technology UK affiliation logo" loading="lazy" width="264" height="190" />
          </span>
          <span class="affiliation-name">Music Technology UK</span>
          <span class="affiliation-role">Member</span>
        </a>
      </div>
    </div>
  </section>

  <section class="about-section" id="how-sonura-works">
    <div class="about-section-inner">
      <h2 class="section-title reveal">How Sonura works</h2>
      <div class="diff-grid">
        <div class="diff-item reveal">
          <h3>Onboarding</h3>
          <p>Sign up free with no credit card and get 20 credits plus a daily allowance. Open the studio in your browser, or install Sonura Flow and sign in from inside your DAW. The <a href="https://youtu.be/hTa_ysLlG9M" target="_blank" rel="noopener" class="text-link">plugin walkthrough</a> runs under seven minutes.</p>
        </div>
        <div class="diff-item reveal" data-reveal-delay="0.04s">
          <h3>Turnaround</h3>
          <p>Generations take under 10 seconds on average, with no queue. Loops land in 5 to 8 seconds and full tracks in 8 to 12.</p>
        </div>
        <div class="diff-item reveal" data-reveal-delay="0.08s">
          <h3>Communication</h3>
          <p>Email <a href="mailto:kindred@sonurastudio.com" class="text-link">kindred@sonurastudio.com</a> and expect a reply within 24 hours, or ask in the <a href="https://discord.com/invite/Yk8RD3Nmyh" target="_blank" rel="noopener" class="text-link">Discord community</a>. Pro and Max plans get priority 24/7 support.</p>
        </div>
        <div class="diff-item reveal" data-reveal-delay="0.04s">
          <h3>Who you'll work with</h3>
          <p>Support comes from the founders, not a ticket queue. Max plan members get one-to-one calls with the team and can request custom features for their workflow.</p>
        </div>
        <div class="diff-item reveal" data-reveal-delay="0.08s">
          <h3>Billing</h3>
          <p>Plans are month-to-month and you can cancel from your account settings at any time. Access continues until the end of the billing period, and annual billing saves 20%.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="about-section" id="key-facts">
    <div class="about-section-inner">
      <h2 class="section-title reveal">Key facts about Sonura</h2>
      <div class="facts-wrap reveal" data-reveal-delay="0.04s">
        <table class="facts-table">
          <caption class="visually-hidden">Key facts about Sonura</caption>
          <tbody>
            {keyFacts.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td set:html={row.value} />
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="about-section contact-section" id="faq">
    <div class="about-section-inner">
      <h2 class="section-title reveal">Frequently asked questions</h2>
      <div class="faq-grid">
        {faqs.map((f, i) => (
          <div class="faq-item reveal" data-reveal-delay={`${0.03 * (i % 3)}s`}>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* A photograph from a Sonura session sits behind the hero. The image is the
     ::before layer so it can be blurred and dimmed on its own, leaving the
     text crisp: a filter on the section itself would soften the type too.
     The overlay is a gradient rather than a flat wash, so the copy side stays
     dark enough to read while the right of the frame keeps some picture. */
  /* Pulled up under the sticky nav so the photo runs behind it, the way the
     homepage hero does. The padding gives the height back. */
  .about-hero {
    margin-top: calc(-1 * var(--nav-h, 70px));
    padding: calc(var(--nav-h, 70px) + clamp(96px, 14vh, 180px)) var(--page-pad) clamp(72px, 9vw, 120px);
    text-align: left;
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .about-hero::before {
    content: '';
    position: absolute;
    /* inset past the edges so the blur has material to sample and never
       feathers into a pale rim at the section boundary */
    inset: -40px;
    z-index: -2;
    background-image: image-set(
      url('/images/about-hero-1920.webp') 1x,
      url('/images/about-hero-1920.webp') 2x
    );
    background-position: center;
    background-size: cover;
    filter: blur(5px) saturate(0.9);
    transform: scale(1.03);
    /* feather every edge so the photo dissolves into the page instead of
       ending on a hard rectangle */
    -webkit-mask-image: radial-gradient(135% 130% at 55% 35%, #000 42%, transparent 88%);
    mask-image: radial-gradient(135% 130% at 55% 35%, #000 42%, transparent 88%);
  }

  .about-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(100deg, rgba(5, 5, 5, 0.9) 0%, rgba(5, 5, 5, 0.77) 45%, rgba(5, 5, 5, 0.46) 100%),
      linear-gradient(to bottom, rgba(5, 5, 5, 0.34) 0%, transparent 26%, rgba(5, 5, 5, 0.88) 100%);
  }

  @media (max-width: 900px) {
    /* one column, so the copy sits over the middle of the frame: flatten the
       sideways gradient into an even wash */
    .about-hero::after {
      background:
        linear-gradient(rgba(5, 5, 5, 0.82), rgba(5, 5, 5, 0.82)),
        linear-gradient(to bottom, rgba(5, 5, 5, 0.55), transparent 32%, rgba(5, 5, 5, 0.92));
    }
  }

  @media (max-width: 768px) {
    .about-hero::before {
      background-image: url('/images/about-hero-1280.webp');
    }
  }

  .about-hero-inner {
    max-width: 1100px;
    margin: 0;
  }

  /* Same rung as the landing's section headings, e.g. "Bring Sonura into your
     DAW": this is a section head, not a hero at the homepage's scale. */
  .about-headline {
    font-family: var(--font-display);
    font-size: clamp(32px, 3.95vw, 48px);
    line-height: 1;
    margin: 0 0 32px;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    font-weight: 400;
    color: var(--fg);
    text-align: left;
  }

  .about-subhead {
    font-size: 17px;
    color: var(--muted);
    line-height: 1.8;
    letter-spacing: 0.022em;
    word-spacing: 0.04em;
    margin: 0;
    max-width: 640px;
