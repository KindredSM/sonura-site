---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingSection from '../components/PricingSection.astro';
import MadeWithSonura from '../components/MadeWithSonura.astro';
import { DAW_LOGOS } from '../data/dawLogos';
import BrandIcon from '../components/icons/BrandIcon.astro';
import '../styles/home-editorial.css';
import '../styles/home-v2.css';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Sonura",
    "alternateName": "Sonura",
    "url": "https://sonurastudio.com/",
    "applicationCategory": "MultimediaApplication",
    "operatingSystem": "Web",
    "offers": { "@type": "Offer", "category": "Music Production" },
    "description": "The AI studio for music production. Royalty-free beats, loops, vocals, stems, one-shots, and full tracks, all in one place.",
    "image": "https://sonurastudio.com/demo-image.jpeg"
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Sonura",
    "alternateName": "Sonura",
    "url": "https://sonurastudio.com/",
    "logo": "https://sonurastudio.com/demo-image.jpeg",
    "sameAs": ["https://twitter.com/sonurastudio", "https://discord.com/invite/Yk8RD3Nmyh"],
    "contactPoint": { "@type": "ContactPoint", "email": "kindred@sonurastudio.com", "contactType": "Customer Support" }
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Sonura",
    "alternateName": "Sonura",
    "applicationCategory": "MusicApplication",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "operatingSystem": "Web Browser",
    "description": "The AI studio for music production. Royalty-free beats, loops, vocals, stems, and full tracks. Free to start, with exclusive commercial rights on paid plans."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Sonura?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sonura is the AI studio for music production. Describe what you want and get professional-quality beats, loops, vocals, and full tracks in seconds. Export stems, iterate endlessly, and use everything commercially."
      }
    },
    {
      "@type": "Question",
      "name": "Is Sonura free to use?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. You get free credits to start creating immediately. No credit card required. Create beats, loops, and tracks at full quality before choosing a plan."
      }
    },
    {
      "@type": "Question",
      "name": "Can I monetize the music I create?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Everything you create with Sonura is yours with exclusive commercial rights on paid plans. Release on Spotify, sell as beats, use in client work. No royalty splits, no attribution required."
      }
    },
    {
      "@type": "Question",
      "name": "Will platforms de-rank my music if I use AI tools?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sonura is for those crafting original arrangements and sound, not replacing the human decisions that make a track yours."
      }
    }
  ]
};

const creatorVideos = [
  {
    title: 'Sample discovery',
    duration: '0:39',
    src: '/videos/creator-demos/creator-demo-1.mp4',
    poster: '/videos/creator-demos/creator-demo-1-poster.jpg',
    credit: '@thedoormanaus',
    creditUrl: 'https://www.instagram.com/thedoormanaus/'
  },
  {
    title: 'DAW workflow',
    duration: '0:33',
    src: '/videos/creator-demos/creator-demo-2.mp4',
    poster: '/videos/creator-demos/creator-demo-2-poster.jpg',
    credit: '@aaronthecratehacker',
    creditUrl: 'https://www.instagram.com/p/DXHi4PgDG2U/'
  },
  {
    title: 'Vocal ideas',
    duration: '0:15',
    src: '/videos/creator-demos/creator-demo-3.mp4',
    poster: '/videos/creator-demos/creator-demo-3-poster.jpg',
    credit: '@sdnoise',
    creditUrl: 'https://www.instagram.com/sdnoise/'
  }
];

---

<BaseLayout
  title="Create Royalty-Free Beats, Loops & Vocals | Sonura"
  description="Produce original beats, loops, vocals, stems, one-shots, and full tracks in seconds. Royalty-free, with exclusive commercial rights on every paid plan."
  keywords="sonura, sonura studio, sonura ai, ai music generator, ai music production, ai music studio, ai beat maker, ai loop maker, ai vocals, text to music, ai song generator, beat maker, loop creator, stem export, royalty free music, music production"
  canonical="https://sonurastudio.com/"
  ogTitle="Create Royalty-Free Beats, Loops & Vocals | Sonura"
  ogDescription="Royalty-free beats, loops, vocals, stems, one-shots, and full tracks, all in one place."
  jsonLd={[...jsonLd, faqSchema]}
  bodyClass="editorial-home home-v2"
>
  <meta slot="head" property="og:video" content="https://www.youtube.com/watch?v=xUuqIAWetXk" />
  <meta slot="head" property="og:video:type" content="text/html" />
  <meta slot="head" property="og:video:width" content="1920" />
  <meta slot="head" property="og:video:height" content="1080" />
  <section class="hero">
    <div class="hero-media" id="hero-video-container" aria-hidden="true">
      <video
        class="hero-video-element hero-video-thumbnail"
        id="video-thumbnail"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/videos/hero-bg-poster.jpg"
      >
        <source src="/videos/hero-bg.webm" type="video/webm" />
        <source src="/videos/hero-bg.mp4" type="video/mp4" />
      </video>
      <span class="hero-scrim"></span>
    </div>

    <div class="hero-content">
      <p class="hero-kicker reveal" data-reveal-delay="0.02s">
        <span class="hero-avatars">
          <img src="/images/doormanaus.jpg" alt="Photo of @thedoormanaus, music creator on Sonura" width="32" height="32" loading="eager" />
          <img src="/images/glassbead.png" alt="Photo of glassBead, music creator on Sonura" width="32" height="32" loading="eager" />
          <img src="/images/aaron.jpg" alt="Photo of @aaronthecratehacker, music creator on Sonura" width="32" height="32" loading="eager" />
        </span>
        <span>Loved by 15,000+ producers</span>
      </p>
      <h1 class="headline reveal" data-reveal-delay="0.04s">Make the sound <strong>in your head<span class="stop">.</span></strong></h1>
      <p class="subhead reveal" data-reveal-delay="0.06s">The ethical AI music studio, on the web or in your DAW.</p>

      <div class="cta reveal" data-reveal-delay="0.08s" id="signup">
        <div class="cta-buttons">
          <a id="cta-button" class="button primary" href="https://app.sonurastudio.com/">Try for free</a>
        </div>
      </div>
    </div>
  </section>

  <MadeWithSonura kicker="" subtitle="" />

  <section class="workflow" aria-labelledby="workflow-title">
    <div class="workflow-inner">
      <div class="workflow-head">
        <h2 id="workflow-title" class="workflow-title reveal" data-reveal-delay="0.06s">A full studio in your browser</h2>
      </div>
      <div class="switcher">
        <div class="switcher-list" role="tablist" aria-label="What you can do in Sonura">
          <button class="switcher-item is-active" type="button" role="tab" aria-selected="true" aria-controls="switch-panel-0" id="switch-tab-0" data-switch="0">
            <span class="switcher-head">
              <span class="switcher-name">Create</span>
            </span>
            <span class="switcher-copy"><span class="switcher-copy-inner">One-shots, vocals, loops and FX made to your exact spec</span></span>
          </button>
          <button class="switcher-item" type="button" role="tab" aria-selected="false" aria-controls="switch-panel-1" id="switch-tab-1" data-switch="1">
            <span class="switcher-head">
              <span class="switcher-name">Compose</span>
            </span>
            <span class="switcher-copy"><span class="switcher-copy-inner">Layer your sounds into a finished arrangement</span></span>
          </button>
          <button class="switcher-item" type="button" role="tab" aria-selected="false" aria-controls="switch-panel-2" id="switch-tab-2" data-switch="2">
            <span class="switcher-head">
              <span class="switcher-name">Collaborate</span>
            </span>
            <span class="switcher-copy"><span class="switcher-copy-inner">Invite people into the same session and work in real time</span></span>
          </button>
          <button class="switcher-item" type="button" role="tab" aria-selected="false" aria-controls="switch-panel-3" id="switch-tab-3" data-switch="3">
            <span class="switcher-head">
              <span class="switcher-name">Publish</span>
            </span>
            <span class="switcher-copy"><span class="switcher-copy-inner">Send it anywhere, with no royalty splits</span></span>
          </button>
        </div>

        <div class="switcher-dots" role="tablist" aria-label="Choose a step">
          {['Create', 'Compose', 'Collaborate', 'Publish'].map((label, i) => (
            <button
              class={`switcher-dot${i === 0 ? ' is-active' : ''}`}
              type="button"
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={label}
              data-switch={i}
            >{String(i + 1).padStart(2, '0')}</button>
          ))}
        </div>

        <a class="button primary switcher-cta" href="https://app.sonurastudio.com/">Try for free</a>

        <h3 class="switcher-badge" aria-hidden="true">Create</h3>

        <div class="switcher-stage">
          <div class="switcher-panel is-active" id="switch-panel-0" role="tabpanel" aria-labelledby="switch-tab-0" data-panel="0">
            <picture>
              <source type="image/webp" srcset="/assets/studio-create-768.webp 768w, /assets/studio-create-1280.webp 1280w" sizes="(max-width: 900px) 100vw, 52vw" />
              <img src="/assets/studio-create-1280.webp" alt="Created loops listed in the Sonura library with waveforms, key and BPM" loading="lazy" decoding="async" width="1280" height="960" />
            </picture>
          </div>
          <div class="switcher-panel" id="switch-panel-1" role="tabpanel" aria-labelledby="switch-tab-1" data-panel="1">
            <picture>
              <source type="image/webp" srcset="/assets/studio-compose-768.webp 768w, /assets/studio-compose-1280.webp 1280w" sizes="(max-width: 900px) 100vw, 52vw" />
              <img src="/assets/studio-compose-1280.webp" alt="A layered arrangement in Sonura with drum, bass, pad and vocal clips" loading="lazy" decoding="async" width="1280" height="960" />
            </picture>
          </div>
          <div class="switcher-panel" id="switch-panel-2" role="tabpanel" aria-labelledby="switch-tab-2" data-panel="2">
            <picture>
              <source type="image/webp" srcset="/assets/studio-collab-768.webp 768w, /assets/studio-collab-1280.webp 1280w" sizes="(max-width: 900px) 100vw, 52vw" />
              <img src="/assets/studio-collab-1280.webp" alt="Inviting a collaborator to a Sonura project as an editor" loading="lazy" decoding="async" width="1280" height="960" />
            </picture>
          </div>
          <div class="switcher-panel" id="switch-panel-3" role="tabpanel" aria-labelledby="switch-tab-3" data-panel="3">
            <picture>
              <source type="image/webp" srcset="/assets/studio-publish-768.webp 768w, /assets/studio-publish-1280.webp 1280w" sizes="(max-width: 900px) 100vw, 52vw" />
              <img src="/assets/studio-publish-1280.webp" alt="A finished Sonura master alongside Spotify, YouTube, SoundCloud and Bandcamp" loading="lazy" decoding="async" width="1280" height="960" />
            </picture>
          </div>
        </div>

        <p class="switcher-mobile-copy">One-shots, vocals, loops and FX made to your exact spec</p>
      </div>
    </div>
  </section>

  <section class="plugin-section" aria-labelledby="plugin-title">
    <div class="plugin-inner">
      <h2 id="plugin-title" class="plugin-heading reveal">Bring Sonura into your DAW</h2>

      <div class="plugin-panel reveal" data-reveal-delay="0.06s">
        <div class="plugin-copy">
          <h3 class="plugin-name">Plugin</h3>
          <p class="plugin-sub">Create sounds without leaving the track</p>

          <ul class="plugin-list">
            <li>Make high-quality drums</li>
            <li>Create vocal stems</li>
            <li>Create multiple stems at once</li>
            <li>Own your library, everything stays yours</li>
          </ul>

          <div class="plugin-daws">
            {DAW_LOGOS.map((logo) => (
              <span class="daw-cell" title={logo.name}>
                <img src={logo.src} alt={logo.name} class={logo.mono ? 'is-mono' : undefined} loading="lazy" />
              </span>
            ))}
            <span class="daw-cell daw-cell-more">+100</span>
          </div>

          <a class="button primary plugin-cta" href="/plugin/">Get the plugin</a>
        </div>

        <div class="plugin-shot">
          <picture>
            <source
              type="image/webp"
              srcset="/images/plugin-flow-768.webp 768w, /images/plugin-flow-1024.webp 1024w"
              sizes="(max-width: 900px) 100vw, 52vw"
            />
            <img src="/images/plugin-flow-1024.webp" alt="Sonura Flow running inside a DAW" loading="lazy" decoding="async" width="1024" height="768" />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <section class="artistry" aria-labelledby="artistry-title">
    <div class="artistry-inner">
  <div class="release-positioning reveal" data-reveal-delay="0.22s">
  <h3 id="artistry-title" class="release-positioning-title">Built for human artistry<span class="stop">.</span></h3>
  <p class="release-positioning-text">Sonura is for those crafting original arrangements and sound. Built on licensed music, not scraped catalogs. It's important to us to stay on the right side of consent. <a href="/how-we-work-with-artists/" class="text-link">Here is how we work with artists</a>.</p>
  <a class="button primary release-positioning-button" href="https://app.sonurastudio.com/">Try for free</a>
  </div>
    </div>
  </section>

  <section class="creator-videos" id="creator-videos" aria-labelledby="creator-videos-title">
    <div class="creator-videos-inner">
      <div class="creator-videos-header">
        <h2 id="creator-videos-title" class="creator-videos-title reveal">Creators using Sonura</h2>
        <p class="creator-videos-subtitle reveal" data-reveal-delay="0.04s">Short product demos from producers putting Sonura into real workflows.</p>
      </div>
      <div class="creator-video-grid" aria-label="Creator video demos">
        {creatorVideos.map((video, index) => (
          <article
            class="creator-video-tile reveal"
            data-reveal-delay={`${0.04 + index * 0.04}s`}
          >
            <button
              class="creator-video-button"
              type="button"
              data-creator-video
              data-video-src={video.src}
              data-video-poster={video.poster}
              aria-label={`Play ${video.title}`}
            >
              <span class="creator-video-media">
                <img src={video.poster} alt={`Preview poster for ${video.title}`} loading="lazy" decoding="async" width="480" height="854" />
                <span class="creator-video-scrim" aria-hidden="true"></span>
                <span class="creator-video-play" aria-hidden="true">
                  <i data-lucide="play"></i>
                </span>
                <span class="creator-video-duration">{video.duration}</span>
              </span>
              <span class="creator-video-copy">
                <span class="creator-video-title">{video.title}</span>
              </span>
            </button>
            <a
              class="creator-video-credit"
              href={video.creditUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`View ${video.credit} on Instagram`}
            >
              <BrandIcon name="instagram" />
              <span>{video.credit}</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
  <div class="creator-video-modal" id="creator-video-modal" hidden aria-hidden="true">
    <div class="creator-video-modal-backdrop" data-creator-video-close></div>
    <button class="creator-video-modal-close" type="button" data-creator-video-close aria-label="Close video">
      <i data-lucide="x"></i>
    </button>
    <div class="creator-video-modal-panel" role="dialog" aria-modal="true" aria-label="Creator video">
      <video id="creator-video-player" class="creator-video-player" controls playsinline preload="metadata"></video>
    </div>
  </div>
  <section class="testimonials" aria-labelledby="testimonials-title">
    <div class="testimonials-inner">
      <div class="testimonials-head">
        <h2 id="testimonials-title" class="testimonials-title reveal">Trusted by producers worldwide</h2>
      </div>
      <div class="testimonials-grid">
        <div class="testimonial-card reveal" data-reveal-delay="0.04s">
          <div class="testimonial-content">
            <p class="testimonial-text">"Whenever I'm chatting with someone about Sonura I tell them that Sonura saves me hours of scrolling through Splice samples."</p>
          </div>
          <div class="testimonial-author">
            <div class="author-avatar" aria-hidden="true">
              <img src="/images/camelia.jpg" alt="" loading="lazy" decoding="async" />
            </div>
            <div class="author-info">
              <p class="author-name">Zero Gravities Aura</p>
              <p class="author-handle">Artist</p>
            </div>
          </div>
        </div>
        
        <div class="testimonial-card reveal" data-reveal-delay="0.08s">
          <div class="testimonial-content">
            <p class="testimonial-text">"I’ve been an electronic musician/record producer for over a decade now — unless you know how to use a console + analog equipment, Sonura is your future."</p>
          </div>
          <div class="testimonial-author">
            <div class="author-avatar" aria-hidden="true">
              <img src="/images/glassbead.png" alt="" loading="lazy" decoding="async" />
            </div>
            <div class="author-info">
              <p class="author-name">glassBead</p>
              <p class="author-handle">DJ and Producer</p>
            </div>
          </div>
        </div>
        
        <div class="testimonial-card reveal" data-reveal-delay="0.12s">
          <div class="testimonial-content">
            <p class="testimonial-text">"The perfect balance between complexity and ease of use. I could go from zero to a complete song with almost no learning curve. A real wow moment for me."</p>
          </div>
          <div class="testimonial-author">
            <div class="author-avatar" aria-hidden="true">
              <img src="/images/antonio.jpeg" alt="" loading="lazy" decoding="async" />
            </div>
            <div class="author-info">
              <p class="author-name">António Ferreira</p>
              <p class="author-handle">Producer</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="pricing" id="pricing" aria-labelledby="pricing-title">
    <div class="pricing-inner">
      <div class="pricing-head">
        <h2 id="pricing-title" class="pricing-heading">Pick your plan</h2>
      </div>
      <PricingSection showHeader={true} showTrust={false} />
    </div>
  </section>
  
  <section class="faq" id="faq" aria-labelledby="faq-title">
    <div class="faq-inner">
      <h2 id="faq-title" class="faq-title">Frequently asked questions</h2>
      <div class="faq-list">
        <details class="reveal">
          <summary>What is Sonura?</summary>
          <p>Sonura is a music production studio. Describe what you want and get professional-quality beats, loops, vocals, and full tracks in seconds. Export stems, iterate endlessly, and use everything commercially.</p>
        </details>
        <details class="reveal" data-reveal-delay="0.03s">
          <summary>Is Sonura free to use?</summary>
          <p>Yes. You get free credits to start creating immediately. No credit card required. Create beats, loops, and tracks at full quality before choosing a plan.</p>
        </details>
        <details class="reveal" data-reveal-delay="0.06s">
          <summary>Can I monetize the music I create?</summary>
          <p>Everything you create with Sonura is yours with exclusive commercial rights on paid plans. Release on Spotify, sell as beats, use in client work, score a film. No royalty splits, no attribution required.</p>
        </details>
        <details class="reveal" data-reveal-delay="0.09s">
          <summary>Will platforms de-rank my music if I use AI tools?</summary>
          <p>Sonura is for those crafting original arrangements and sound, not replacing the human decisions that make a track yours.</p>
        </details>
        <details class="reveal" data-reveal-delay="0.12s">
          <summary>What genres does Sonura support?</summary>
          <p>Virtually every genre: trap, house, techno, pop, rock, jazz, lo-fi, drill, R&B, country, ambient, cinematic, and more. Sonura understands sub-genres and specific style descriptors so you get exactly the sound you're after.</p>
        </details>
        <details class="reveal" data-reveal-delay="0.18s">
          <summary>Do I need production experience?</summary>
          <p>No. Sonura works for complete beginners and professional producers alike. If you can describe what you want, you can create it. No DAW knowledge or music theory required, though it integrates seamlessly if you have them.</p>
        </details>
        <details class="reveal" data-reveal-delay="0.24s">
          <summary>How fast is creation?</summary>
          <p>Under 10 seconds on average. Loops in 5–8 seconds, full tracks in 8–12 seconds. No queues, no rendering delays.</p>
        </details>
        <details class="reveal" data-reveal-delay="0.3s">
          <summary>Can I export stems for my DAW?</summary>
          <p>Yes. Export individual stems (drums, bass, melody, FX, vocals) or the full mix, ready to drop into Ableton, FL Studio, Logic, Reaper, Pro Tools, and any DAW.</p>
        </details>
        <details class="reveal" data-reveal-delay="0.32s">
          <summary>Does the plugin work in my DAW?</summary>
          <p>Almost certainly. The free Sonura Flow plugin runs right inside Ableton Live, Logic Pro, FL Studio, Reaper, Studio One, Bitwig, Cubase, GarageBand, and any other VST3 or AU host, on Mac and Windows.</p>
        </details>
        <details class="reveal" data-reveal-delay="0.36s">
          <summary>How is Sonura different from sample packs?</summary>
          <p>Sample packs are pre-made and shared across thousands of producers. Sonura creates completely original audio tailored to your exact specifications. Every creation is unique and matched to your vision.</p>
        </details>
        <details class="reveal" data-reveal-delay="0.42s">
          <summary>What makes Sonura different from other AI music tools?</summary>
          <p>Sonura is built for producers, not just listeners. You get stem exports, multi-track layering, real-time iteration, exclusive commercial rights on paid plans, and studio-grade output, all in one platform. Most AI music tools create a finished song you can't edit. Sonura gives you the building blocks.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="final-cta" aria-labelledby="final-cta-title">
    <div class="final-cta-inner">
      <h2 id="final-cta-title" class="final-cta-title reveal">Own your sound<span class="stop">.</span></h2>
      <p class="final-cta-subtitle reveal" data-reveal-delay="0.06s">Free to start / No credit card / No setup</p>
      <div class="final-cta-form reveal" data-reveal-delay="0.12s">
        <a class="button primary large" href="https://app.sonurastudio.com/">Try for free</a>
      </div>
    </div>
  </section>

<script>
  // Workflow switcher: one item lit at a time, its panel shown on the stage.
  // One behaviour, applied to every .switcher on the page (studio + plugin).
  document.querySelectorAll('.switcher').forEach((root) => {
    const list = root.querySelector('.switcher-list');
    if (!list) return;
    const items = [...list.querySelectorAll('.switcher-item')];
    const panels = [...root.querySelectorAll('.switcher-panel')];
    const dots = [...root.querySelectorAll('.switcher-dot')];
    const badge = root.querySelector('.switcher-badge');
    const mobileCopy = root.querySelector('.switcher-mobile-copy');
    const stage = root.querySelector('.switcher-stage');
    let current = 0;

    const show = (i) => {
      items.forEach((el, n) => {
        const on = n === i;
        el.classList.toggle('is-active', on);
        el.setAttribute('aria-selected', String(on));
      });
      panels.forEach((el, n) => {
        const on = n === i;
        el.classList.toggle('is-active', on);
        // aria-hidden, not [hidden]: display:none would cancel the cross-fade
        el.setAttribute('aria-hidden', String(!on));
      });

      // Mobile chrome: dots, the label over the stage, and the copy below it.
      dots.forEach((d, n) => {
        const on = n === i;
        d.classList.toggle('is-active', on);
        d.setAttribute('aria-selected', String(on));
      });
      if (badge) badge.textContent = items[i].querySelector('.switcher-name').textContent;
      if (mobileCopy) mobileCopy.textContent = items[i].querySelector('.switcher-copy-inner').textContent;
      current = i;
    };

    items.forEach((el, i) => {
      el.addEventListener('click', () => show(i));
      el.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        e.preventDefault();
        const next = (i + (e.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length;
        items[next].focus();
        show(next);
      });
    });

    dots.forEach((d, i) => d.addEventListener('click', () => show(i)));

    const step = (delta) => show((current + delta + items.length) % items.length);
    // Swipe on the stage. Horizontal intent only, so a vertical scroll that
    // starts on the image is never hijacked.
    if (stage) {
      let startX = 0;
      let startY = 0;
      let tracking = false;
      stage.addEventListener('pointerdown', (e) => {
        startX = e.clientX;
        startY = e.clientY;
        tracking = true;
      });
      stage.addEventListener('pointerup', (e) => {
        if (!tracking) return;
        tracking = false;
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        if (Math.abs(dx) > 44 && Math.abs(dx) > Math.abs(dy)) step(dx < 0 ? 1 : -1);
      });
      stage.addEventListener('pointercancel', () => { tracking = false; });
    }

    show(0);
  });


  // Loops / one-shots / songs: the bar under the active tab is positioned from
  // measured geometry, so switching costs no layout and cannot snap.
  const toggle = document.querySelector('.demo-toggle');
  if (toggle) {
    const tabs = [...toggle.querySelectorAll('.demo-toggle-btn')];
    const place = () => {
      // the component marks state with aria-selected, not a class
      const on = toggle.querySelector('.demo-toggle-btn[aria-selected="true"]') || tabs[0];
      if (!on) return;
      const a = on.getBoundingClientRect();
      const b = toggle.getBoundingClientRect();
      toggle.style.setProperty('--ind-w', Math.round(a.width) + 'px');
      toggle.style.setProperty('--ind-x', Math.round(a.left - b.left) + 'px');
    };
    tabs.forEach((t) => t.addEventListener('click', () => requestAnimationFrame(place)));
    window.addEventListener('resize', place);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(place);
    place();
  }


</script>
</BaseLayout>

