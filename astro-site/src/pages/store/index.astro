---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoreCarousel from '../../components/StoreCarousel.astro';
import { products, RUN } from '../../data/store';
---

<BaseLayout
  title="Store | Sonura Merch, Run 001"
  description="Sonura merch. A black tee with the prompt box on the back and a final_v7.wav cap, from our first run."
  canonical="https://sonurastudio.com/store/"
  ogTitle="Sonura Store | Run 001"
  ogDescription="A prompt box tee and a final_v7.wav cap. Our first run of merch."
  ogImage="https://sonurastudio.com/images/store/og.png"
  ogImageAlt="Black Sonura tee with a prompt box printed on the back"
  bodyClass="store-page"
>
  <header class="sg-head">
    <h1>Store</h1>
    <span>{RUN}</span>
  </header>

  <ul class="sg-grid">
    {products.map((p) => (
      <li class="sg-item" data-store-tile={p.cat}>
        <StoreCarousel images={p.images} href={`/store/${p.id}/`} eager />
        <a href={`/store/${p.id}/`} class="sg-cap">
          <span class="sg-name">{p.name}</span>
          <span class="sg-price">${p.price}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<script>
  const w = window as Window & { posthog?: { capture: (e: string, p?: object, o?: object) => void } };
  document.querySelectorAll<HTMLElement>('[data-store-tile]').forEach((tile) => {
    tile.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => {
      try { w.posthog?.capture('store_product_opened', { cat: tile.dataset.storeTile }, { transport: 'sendBeacon' }); } catch {}
    }));
  });
</script>

<style>
  .sg-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 18px var(--page-pad);
  }
  .sg-head h1, .sg-head span {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sg-head h1 { color: var(--fg); }

  .sg-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--hairline);
  }
  .sg-item { position: relative; }
  .sg-item + .sg-item::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -0.5px;
    width: 1px;
    background: var(--hairline);
    z-index: 2;
    pointer-events: none;
  }

  .sg-cap {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 18px clamp(16px, 2vw, 28px) 44px;
    border-top: 1px solid var(--hairline);
    color: var(--fg);
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .sg-name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    text-decoration-color: transparent;
    transition: text-decoration-color 0.2s ease;
  }
  .sg-price { color: var(--muted); font-variant-numeric: tabular-nums; transition: color 0.2s ease; }

  @media (hover: hover) {
    .sg-item:hover :global(.sc-slide img) { transform: scale(1.06); }
    .sg-item:hover .sg-name { text-decoration-color: currentColor; }
    .sg-item:hover .sg-price { color: var(--fg); }
  }

  :global(body.store-page .footer) { border-top-color: var(--hairline); }

  @media (max-width: 640px) {
    .sg-grid { grid-template-columns: 1fr; }
    .sg-item + .sg-item::before { display: none; }
    .sg-item + .sg-item { border-top: 1px solid var(--hairline); }
  }
</style>
