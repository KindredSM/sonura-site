---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products, RUN } from '../../data/store';
---

<BaseLayout
  title="Store | Sonura Merch, Run 001"
  description="Sonura merch. A black tee with the prompt box on the back and a final_v7.wav cap, from our first run."
  canonical="https://sonurastudio.com/store/"
  ogTitle="Sonura Store | Run 001"
  ogDescription="A prompt box tee and a final_v7.wav cap. Our first run of merch."
  ogImage="https://sonurastudio.com/images/store/og.png"
  ogImageAlt="Black Sonura tee with a prompt box printed on the back"
  bodyClass="store-page"
>
  <header class="sg-head">
    <h1>Store</h1>
    <span>{RUN}</span>
  </header>

  <ul class="sg-grid">
    {products.map((p) => {
      const [main, alt] = p.images;
      return (
        <li>
          <a href={`/store/${p.id}/`} class="sg-tile" data-store-tile={p.cat}>
            <span class="sg-media">
              <picture>
                <source srcset={`${main.src}.webp`} type="image/webp" />
                <img src={`${main.src}.jpg`} alt={main.alt} width="1024" height="1024" loading="eager" />
              </picture>
              {alt && (
                <picture class="sg-alt">
                  <source srcset={`${alt.src}.webp`} type="image/webp" />
                  <img src={`${alt.src}.jpg`} alt="" width="1024" height="1024" loading="lazy" />
                </picture>
              )}
            </span>
            <span class="sg-cap">
              <span class="sg-name">{p.name}</span>
              <span class="sg-price">${p.price}</span>
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</BaseLayout>

<script>
  const w = window as Window & { posthog?: { capture: (e: string, p?: object, o?: object) => void } };
  document.querySelectorAll<HTMLAnchorElement>('[data-store-tile]').forEach((a) => {
    a.addEventListener('click', () => {
      try { w.posthog?.capture('store_product_opened', { cat: a.dataset.storeTile }, { transport: 'sendBeacon' }); } catch {}
    });
  });
</script>

<style>
  .sg-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 18px var(--page-pad);
  }
  .sg-head h1, .sg-head span {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sg-head h1 { color: var(--fg); }

  .sg-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--hairline);
  }
  .sg-grid li + li { border-left: 1px solid var(--hairline); }

  .sg-tile { display: block; color: var(--fg); text-decoration: none; }
  .sg-media { display: block; position: relative; aspect-ratio: 1; overflow: hidden; }
  .sg-media picture { position: absolute; inset: 0; }
  .sg-media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .sg-alt { opacity: 0; transition: opacity 0.35s ease; }

  @media (hover: hover) {
    .sg-tile:hover .sg-alt { opacity: 1; }
  }

  .sg-cap {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 16px clamp(16px, 2vw, 28px) 40px;
    border-top: 1px solid var(--hairline);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .sg-price { color: var(--muted); font-variant-numeric: tabular-nums; }

  @media (max-width: 640px) {
    .sg-grid { grid-template-columns: 1fr; }
    .sg-grid li + li { border-left: 0; border-top: 1px solid var(--hairline); }
  }
</style>
