---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoreCarousel from '../../components/StoreCarousel.astro';
import { products, RUN, type Product } from '../../data/store';

export function getStaticPaths() {
  return products.map((p) => ({ params: { id: p.id }, props: { p } }));
}

const { p } = Astro.props as { p: Product };
const sized = p.variants.length > 1;
const url = `https://sonurastudio.com/store/${p.id}/`;
---

<BaseLayout
  title={`${p.name} | Sonura Store`}
  description={`${p.name}. ${p.format}, $${p.price}. Sonura merch ${RUN}.`}
  canonical={url}
  ogTitle={`${p.name} | Sonura Store`}
  ogImage={`https://sonurastudio.com${p.images[0].src}.jpg`}
  ogImageAlt={p.images[0].alt}
  bodyClass="store-page"
  jsonLd={[{
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `Sonura ${p.name}`,
    sku: p.cat,
    image: p.images.map((i) => `https://sonurastudio.com${i.src}.jpg`),
    brand: { '@type': 'Brand', name: 'Sonura' },
  }]}
>
  <nav class="sp-crumb" aria-label="Breadcrumb">
    <a href="/store/">Store</a>
    <span>{p.cat}</span>
  </nav>

  <section class="sp">
    <div class="sp-gallery">
      <StoreCarousel images={p.images} eager />
    </div>

    <div class="sp-info">
      <div class="sp-panel" data-product={p.cat} data-name={p.name} data-price={p.price}>
        <h1 class="sp-name">{p.name}</h1>
        <p class="sp-price">${p.price}</p>

        {sized ? (
          <fieldset class="sp-sizes">
            <legend>Size</legend>
            <div class="sp-size-row">
              {p.variants.map((v) => (
                <label class="sp-size">
                  <input type="radio" name="size" value={v.sku} data-size={v.size} />
                  <span>{v.size}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ) : (
          <input type="hidden" name="size" value={p.variants[0].sku} data-size={p.variants[0].size} />
        )}

        <button type="button" class="button primary sp-btn" data-buy>
          {sized ? 'Select a size' : 'Buy now'}
        </button>

        <form class="sp-wait" hidden>
          <label for="wait-email">Get on the waitlist</label>
          <div class="sp-wait-row">
            <input id="wait-email" class="sp-wait-input" type="email" name="email" required autocomplete="email" placeholder="Email" />
            <button type="submit" class="button primary sp-wait-btn">Join</button>
          </div>
        </form>

        <p class="sp-done" hidden>You're on the waitlist</p>

        <dl class="sp-specs">
          {p.specs.map((s) => (
            <div>
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY } from '../../data/supabase';

  type Win = Window & {
    posthog?: { capture: (e: string, p?: object, o?: object) => void; get_distinct_id?: () => string };
    gtag?: (...a: unknown[]) => void;
  };
  const w = window as Win;

  const track = (event: string, props: Record<string, unknown>) => {
    try { w.posthog?.capture(event, props); } catch {}
    try { w.gtag?.('event', event, props); } catch {}
  };

  const distinctId = () => {
    try { return w.posthog?.get_distinct_id?.() || null; } catch { return null; }
  };

  const insert = (table: string, row: Record<string, unknown>) =>
    fetch(`${SUPABASE_URL}/rest/v1/${table}`, {
      method: 'POST',
      keepalive: true,
      headers: {
        'Content-Type': 'application/json',
        apikey: SUPABASE_PUBLISHABLE_KEY,
        Prefer: 'return=minimal',
      },
      body: JSON.stringify(row),
    });

  const panel = document.querySelector<HTMLElement>('.sp-panel')!;
  const cat = panel.dataset.product!;
  const product = panel.dataset.name!;
  const price = Number(panel.dataset.price);
  const buy = panel.querySelector<HTMLButtonElement>('[data-buy]')!;
  const sizes = panel.querySelector<HTMLElement>('.sp-sizes');
  const wait = panel.querySelector<HTMLFormElement>('.sp-wait')!;
  const done = panel.querySelector<HTMLElement>('.sp-done')!;
  const email = wait.querySelector<HTMLInputElement>('input[type="email"]')!;
  const join = wait.querySelector<HTMLButtonElement>('button')!;

  const selected = () => panel.querySelector<HTMLInputElement>('input[type="hidden"], input[type="radio"]:checked');
  const choice = () => {
    const v = selected();
    return v ? { sku: v.value, size: v.dataset.size ?? null } : null;
  };

  track('store_product_viewed', { cat, product, price });

  panel.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((r) => {
    r.addEventListener('change', () => {
      sizes?.classList.remove('is-missing');
      if (wait.hidden) buy.textContent = 'Buy now';
      track('store_size_selected', { cat, sku: r.value, size: r.dataset.size });
    });
  });

  buy.addEventListener('click', () => {
    const c = choice();
    if (!c) {
      sizes?.classList.add('is-missing');
      track('store_buy_without_size', { cat });
      return;
    }
    track('store_buy_clicked', { cat, product, price, ...c });
    insert('merch_buy_clicks', { ...c, product, distinct_id: distinctId() }).catch(() => {});
    buy.hidden = true;
    wait.hidden = false;
    email.focus();
  });

  wait.addEventListener('submit', async (e) => {
    e.preventDefault();
    const c = choice();
    if (!c || !email.checkValidity()) return;
    join.disabled = true;
    try {
      const res = await insert('merch_interest', {
        email: email.value.trim().toLowerCase(),
        product,
        distinct_id: distinctId(),
        ...c,
      });
      if (!res.ok && res.status !== 409) throw new Error(String(res.status));
      track('store_waitlist_joined', { cat, product, price, ...c });
      wait.hidden = true;
      done.hidden = false;
    } catch {
      join.disabled = false;
      join.textContent = 'Retry';
    }
  });
</script>

<style>
  .sp-crumb {
    display: flex;
    justify-content: space-between;
    padding: 18px var(--page-pad);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sp-crumb a { color: var(--fg); text-decoration: none; }
  .sp-crumb a::before { content: '← '; }

  .sp {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    border-top: 1px solid var(--hairline);
  }


  .sp-gallery :global(.sc-slide img) { max-height: calc(100svh - var(--nav-h) - 54px); }

  .sp-info { border-left: 1px solid var(--hairline); padding: clamp(28px, 3vw, 48px) var(--page-pad) 64px clamp(24px, 3vw, 48px); }
  .sp-panel { position: sticky; top: calc(var(--nav-h) + 28px); max-width: 440px; }

  .sp-name {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.4;
  }
  .sp-price {
    margin: 6px 0 32px;
    font-size: 15px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .sp-sizes { border: 0; margin: 0 0 12px; padding: 0; min-width: 0; }
  .sp-sizes legend, .sp-wait label, .sp-done {
    padding: 0;
    margin: 0 0 10px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sp-wait label { display: block; color: var(--fg); }
  .sp-size-row { display: grid; grid-template-columns: repeat(5, 1fr); }
  .sp-size { position: relative; }
  .sp-size + .sp-size span { margin-left: -1px; }
  .sp-size input { position: absolute; opacity: 0; inset: 0; margin: 0; }
  .sp-size span {
    display: grid;
    place-items: center;
    height: 48px;
    border: 1px solid var(--hairline);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--muted);
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .sp-size:hover span { color: var(--fg); }
  .sp-size input:checked + span { position: relative; z-index: 1; background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .sp-size input:focus-visible + span { outline: 1px solid var(--fg); outline-offset: 2px; }
  .sp-sizes.is-missing span { border-color: var(--fg); color: var(--fg); }
  .sp-sizes.is-missing legend { color: var(--fg); }

  .sp-btn, .sp-wait-btn {
    padding: 18px 24px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .sp-btn { width: 100%; }

  .sp-wait-row { display: flex; }
  .sp-wait-input {
    flex: 1;
    min-width: 0;
    height: 56px;
    padding: 0 16px;
    border: 1px solid var(--hairline);
    border-right: 0;
    border-radius: var(--radius-ui);
    background: transparent;
    color: var(--fg);
    font-size: 15px;
    letter-spacing: 0.02em;
    outline: none;
  }
  .sp-wait-input::placeholder { color: var(--faint); }
  .sp-wait-input:focus { border-color: var(--fg); }
  .sp-wait-btn { height: 56px; padding: 0 28px; }

  .sp-done { margin: 0; padding: 20px 0 0; color: var(--fg); }

  [hidden] { display: none !important; }

  :global(body.store-page .footer) { border-top-color: var(--hairline); }

  .sp-specs { margin: 32px 0 0; }
  .sp-specs div {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 16px;
    padding: 11px 0;
    border-top: 1px solid var(--hairline);
    font-size: 13px;
  }
  .sp-specs div:last-child { border-bottom: 1px solid var(--hairline); }
  .sp-specs dt {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
    padding-top: 1px;
  }
  .sp-specs dd { margin: 0; color: var(--fg); }

  @media (max-width: 900px) {
    .sp-gallery :global(.sc-slide img) { max-height: none; }
    .sp { grid-template-columns: 1fr; }
    .sp-info { border-left: 0; border-top: 1px solid var(--hairline); padding: 24px var(--page-pad) 56px; }
    .sp-panel { position: static; max-width: none; }
  }
</style>
